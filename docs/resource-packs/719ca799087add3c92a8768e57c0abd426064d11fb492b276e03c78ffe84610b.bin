ansform .7s ease}.cj-runner{position:absolute;left:53%;top:65%;height:31%;aspect-ratio:.9;transform:translate(-50%,-50%);transition:transform .7s ease}.drama-cun-ju.at-line-2 .cj-child,.drama-cun-ju.at-line-3 .cj-child{transform:translate(-45%,-54%)}.drama-cun-ju.at-line-2 .cj-runner,.drama-cun-ju.at-line-3 .cj-runner{transform:translate(-40%,-56%)}.cj-kite-group{position:absolute;left:60%;top:14%;width:24%;height:45%;opacity:.45;transform:translateY(8%);transition:opacity .7s ease,transform .85s ease}.drama-cun-ju.at-line-3 .cj-kite-group{opacity:1;transform:translateY(-6%)}.cj-string{position:absolute;inset:12% 16% 0 0;width:100%;height:100%}.cj-kite{position:absolute;right:0;top:0;width:46%;height:46%}.poem-atmosphere{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}.atm-particle{position:absolute;display:block}.atm-petals .atm-particle{width:11px;height:7px;border-radius:75% 15% 75% 25%;background:#f6b2c0e0}.atm-snow .atm-particle{width:8px;height:8px;border-radius:50%;background:#ffffffe6;box-shadow:0 0 6px #ffffffb3}.atm-rain .atm-particle{width:2px;height:16px;border-radius:2px;background:linear-gradient(180deg,transparent,rgba(218,240,255,.78));transform:rotate(12deg)}.atm-leaves .atm-particle{width:12px;height:8px;border-radius:70% 10%;background:#da723ad9}.atm-stars .atm-particle{width:6px;height:6px;border-radius:50%;background:#fff6c2;box-shadow:0 0 8px #fff4aaf2}.atm-fireflies .atm-particle{width:7px;height:7px;border-radius:50%;background:#ffe078;box-shadow:0 0 11px #ffe06ef2}.atm-sparks .atm-particle{width:7px;height:7px;border-radius:50%;background:#ffce70e6}.atm-wisp{position:absolute;border-radius:50%;background:radial-gradient(circle,rgba(255,255,250,.36) 0%,transparent 72%)}.atm-wisp.wisp-a{left:8%;top:18%;width:32%;height:22%}.atm-wisp.wisp-b{left:46%;top:12%;width:36%;height:24%}.atm-wisp.wisp-c{left:26%;top:38%;width:30%;height:18%}.atm-shimmer{position:absolute;height:3px;border-radius:99px;background:#fffce473}.atm-shi