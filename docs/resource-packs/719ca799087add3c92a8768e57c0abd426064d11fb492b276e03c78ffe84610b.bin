notebook.webp",52,60,45],["art/wordbook/painted/pencil.webp",40,41,33,"draw",19,10]]},数:{sentence:"指一指，数出三颗草莓。",setting:"warm",layers:[["art/berry.webp",31,55,21],["art/berry.webp",50,55,21],["art/berry.webp",69,55,21],["art/wordbook/painted/point-up.webp",30,75,22,"slide",39,0]]},点:{sentence:"小手指轻轻点亮一盏灯。",setting:"night",layers:[["art/wordbook/painted/lamp.webp",53,45,40,"light"],["art/wordbook/painted/point-up.webp",39,71,26,"peck",9,-10]]},中:{sentence:"小熊站到两棵树的中间。",setting:"meadow",layers:[["art/play/tree.webp",25,52,48],["art/play/tree.webp",75,52,48],["art/bear.webp",30,68,33,"walk",20,0]]},远:{sentence:"小船越漂越远，看起来变小了。",setting:"pond",layers:[["art/play/boat.webp",38,68,39,"recede",19,-25]]},近:{sentence:"小鸟从远处飞到我们跟前。",setting:"dawn",layers:[["art/play/bird.webp",60,36,39,"approach",-11,19]]},高:{sentence:"小树越长越高，超过身旁的小熊。",setting:"meadow",layers:[["art/bear.webp",69,73,23],["art/play/tree.webp",44,53,64,"grow"]]},低:{sentence:"长颈鹿低下头来喝水。",setting:"pond",layers:[["art/wordbook/painted/giraffe.webp",50,54,54,"bow"]]},长:{sentence:"短短的尺子展开，变得很长。",setting:"paper",layers:[["art/wordbook/painted/ruler.webp",50,53,50,"unfold"]]},短:{sentence:"长铅笔旁，放上一支短铅笔。",setting:"paper",layers:[["art/wordbook/painted/pencil.webp",38,48,48],["art/wordbook/painted/pencil.webp",68,61,25,"settle",-3,0]]},多:{sentence:"篮子旁边，又添了好几颗草莓。",setting:"clearing",layers:[["art/play/basket.webp",28,63,34],["art/berry.webp",53,65,20,"bloom"],["art/berry.webp",65,54,20,"bloom"],["art/berry.webp",74,69,20,"bloom"]]},少:{sentence:"三颗栗子滚走两颗，只剩一颗。",setting:"clearing",layers:[["art/nut.webp",33,61,23,"depart",-25,0],["art/nut.webp",51,61,23],["art/nut.webp",69,61,23,"depart",24,0]]},空:{sentence:"苹果拿走了，篮子空了。",setting:"warm",layers:[["art/play/basket.webp",49,66,48],["art/wordbook/painted/apple.webp",49,55,27,"depart",25,-30]]},满:{sentence:"把最后一个苹果放上去，篮子满啦。",setting:"warm",layers:[["art/play/basket.webp",50,68,47],["art/wordbook/painted/apple.webp",40,57,21],["art/wordbook/painted/apple.webp",60,57,21],["art/wordbook/painted/apple.webp",49,28,23,"drop",0,22]]},快:{sentence:"小兔飞快地跑过小乌龟。",setting:"meadow",layers:[["art/wordbook/painted/turtle.webp",52,68,26,"crawl",4,0],["art/wordbook/painted/rabbit.webp",23,54,32,"gallop",50,0]]},慢:{sentence:"小蜗牛一步一步，慢慢爬过叶子。",setting:"meadow",layers:[["art/wordbook/painted/green-leaf.webp",50,70,43],["art/wordbook/painted/snail.webp",34,54,26,"crawl",19,0]]},轻:{sentence:"轻轻的羽毛，被风吹起来。",setting:"meadow",layers:[["art/wordbook/painted/feather.webp",43,65,29,"drift",20,-34]]},重:{sentence:"沉沉的石头落地，纹丝不动。",setting:"clearing",layers:[["art/wordbook/painted/stone.webp",50,34,43,"fall",0,29]]},热:{sentence:"一碗热汤端上来，热气往上冒。",setting:"warm",layers:[["art/wordbook/painted/soup.webp",50,67,45],["art/wordbook/painted/steam.webp",50,47,24,"rise",0,-18]]},冷:{sentence:"寒风吹过，冻得浑身发抖。",setting:"storm",layers:[["art/wordbook/painted/cold-child.webp",51,55,44,"shiver"],["art/wordbook/painted/snowflake.webp",28,32,18,"drift",15,17]]},我:{sentence:"小朋友指着自己说：「这是我。」",setting:"warm",layers:[["art/wordbook/child.webp",49,56,55],["art/wordbook/painted/point-left.webp",68,54,23,"slide",-12,0]]},你:{sentence:"我朝你挥挥手，说声「你好」。",setting:"paper",layers:[["art/wordbook/palm.webp",50,53,53,"wave"],["art/wordbook/painted/talk.webp",69,33,21,"bloom"]]},他:{sentence:"看，那个男孩跑来了，他是我的朋友。",setting:"meadow",layers:[["art/wordbook/painted/boy.webp",40,52,45,"approach",10,4],["art/wordbook/painted/point-left.webp",70,55,21,"nod"]]},她:{sentence:"看，那个女孩走来了，她是我的朋友。",setting:"meadow",layers:[["art/wordbook/painted/girl.webp",40,51,44,"approach",10,4],["art/wordbook/painted/point-left.webp",70,55,21,"nod"]]},们:{sentence:"你和我站在一起，就是我们。",setting:"warm",layers:[["art/wordbook/painted/girl.webp",28,53,38,"slide",11,0],["art/wordbook/painted/boy.webp",73,53,39,"slide",-12,0]]},的:{sentence:"这是我的书包，把书包背在我身上。",setting:"paper",layers:[["art/wordbook/child.webp",49,57,53],["art/play/satchel.webp",26,43,23,"settle",16,6]]},是:{sentence:"看一看，这是一只小猫。",setting:"warm",layers:[["art/wordbook/painted/ginger-cat.webp",50,53,45],["art/wordbook/painted/point-up.webp",31,69,22,"slide",11,-3]]},有:{sentence:"打开篮子看，里面有一个苹果。",setting:"paper",layers:[["art/play/basket.webp",50,68,45],["art/wordbook/painted/apple.webp",50,57,26,"rise",0,-24]]},在:{sentence:"看，小鸟就在鸟窝里。",setting:"meadow",layers:[["art/play/nest.webp",50,68,41],["art/play/bird.webp",50,55,31,"bob"]]},不:{sentence:"不想吃了，小朋友摇摇头。",setting:"warm",layers:[["art/wordbook/painted/rice-bowl.webp",30,67,29],["art/wordbook/painted/boy.webp",62,50,42,"shake"]]},和:{sentence:"小熊和小兔并排坐，一起看月亮。",setting:"night-sky",layers:[["art/wordbook/moon.webp",53,28,25],["art/bear.webp",36,67,36],["art/wordbook/painted/rabbit.webp",73,71,29,"hop",-12,0]]},也:{sentence:"小熊来玩球，小兔也来了。",setting:"meadow",layers:[["art/bear.webp",34,59,38],["art/wordbook/painted/football.webp",50,69,23],["art/wordbook/painted/rabbit.webp",77,64,30,"hop",-15,0]]},要:{sentence:"想要那个苹果，伸出小手指一指。",setting:"paper",layers:[["art/wordbook/painted/apple.webp",62,48,34],["art/wordbook/painted/point-up.webp",29,67,30,"slide",19,-5]]},好:{sentence:"搭好了积木，竖起拇指说真好。",setting:"warm",layers:[["art/wordbook/painted/block-tower.webp",38,65,36],["art/wordbook/painted/thumbs-up.webp",65,52,32,"rise",0,-11]]},爱:{sentence:"爱是抱一抱，心也暖起来。",setting:"warm",layers:[["art/bear.webp",38,58,43],["art/bear.webp",66,64,30,"slide",-12,0],["art/wordbook/painted/heart.webp",52,36,23,"beat"]]},会:{sentence:"学会骑车啦，小朋友自己骑起来。",setting:"meadow",layers:[["art/wordbook/painted/cyclist.webp",30,59,45,"ride",37,-2]]},了:{sentence:"昨天还是花苞，今天已经开花了。",setting:"meadow",layers:[["art/wordbook/painted/tulip.webp",50,56,40,"vanish"],["art/wordbook/painted/blossom.webp",50,56,45,"bloom"]]},朋:{sentence:"好朋友见面，互相挥挥手。",setting:"meadow",layers:[["art/wordbook/painted/girl.webp",34,52,37],["art/wordbook/painted/boy.webp",66,52,37],["art/wordbook/palm.webp",48,59,20,"wave"]]},友:{sentence:"把球传给朋友，一起玩。",setting:"meadow",layers:[["art/wordbook/child.webp",26,53,37],["art/bear.webp",74,58,34],["art/wordbook/painted/football.webp",38,66,21,"roll",24,0]]},请:{sentence:"请坐，把椅子推到客人身边。",setting:"warm",layers:[["art/wordbook/child.webp",64,52,42],["art/wordbook/painted/chair.webp",31,65,32,"slide",20,0]]},谢:{sentence:"接过礼物，点点头说谢谢。",setting:"warm",layers:[["art/wordbook/painted/girl.webp",62,46,40,"nod"],["art/wordbook/painted/gift.webp",31,65,26,"serve",20,-3]]},孩:{sentence:"孩子背上书包，蹦蹦跳跳去上学。",setting:"meadow",layers:[["art/wordbook/child.webp",31,57,46,"hop",25,0],["art/play/satchel.webp",27,52,19,"hop",25,0]]}};export{e as h,a as w};
const n=JSON.parse('[{"id":"p1a-k01","title":"江南","author":"汉乐府","group":"一年级上册","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ef9cd9ba44bb.aspx","lines":["江南可采莲，","莲叶何田田。","鱼戏莲叶间。","鱼戏莲叶东，","鱼戏莲叶西，","鱼戏莲叶南，","鱼戏莲叶北。"],"textSource":"https://www.guwendao.net/shiwenv_ef9cd9ba44bb.aspx","audio":"media/poems/p1a-k01.mp3","lineStarts":[0,1.5591,3.678,5.2248,6.6712,8.2003,10.2314]},{"id":"p1a-k02","title":"对韵歌","author":"佚名","group":"一年级上册","grade":1,"volume":"上","kind":"韵文","url":"https://www.guwendao.net/shiwenv_a2b4157395ca.aspx","lines":[],"textSource":"","note":"来源页标为近现代佚名作品，暂收索引。"},{"id":"p1a-j01","title":"咏鹅","author":"骆宾王","group":"一年级上册(日积月累)","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_eeb3869b6242.aspx","lines":["鹅，鹅，鹅，","曲项向天歌。","白毛浮绿水，","红掌拨清波。"],"textSource":"https://www.guwendao.net/shiwenv_eeb3869b6242.aspx","audio":"media/poems/p1a-j01.mp3","lineStarts":[0,1.6207,3.0691,4.5195]},{"id":"p1a-j02","title":"画","author":"王维","group":"一年级上册(日积月累)","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_b6bd9a33dfd7.aspx","lines":["远看山有色，","近听水无声。","春去花还在，","人来鸟不惊。"],"textSource":"https://www.guwendao.net/shiwenv_b6bd9a33dfd7.aspx","note":"沿用目录署名王维；此诗作者另有不同说法。","audio":"media/poems/p1a-j02.mp3","lineStarts":[0,1.5073,3.2232,4.7032]},{"id":"p1a-j03","title":"悯农二首·其二","author":"李绅","group":"一年级上册(日积月累)","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_6e878b858e01.aspx","lines":["锄禾日当午，","汗滴禾下土。","谁知盘中餐，","粒粒皆辛苦。"],"textSource":"https://www.guwendao.net/shiwenv_6e878b858e01.aspx","audio":"media/poems/p1a-j03.mp3","lineStarts":[0,1.3945,2.9145,4.3286]},{"id":"p1a-j04","title":"古朗月行(节选)","author":"李白","group":"一年级上册(日积月累)","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_8616581bb564.aspx","lines":["小时不识月，","呼作白玉盘。","又疑瑶台镜，","飞在青云端。"],"textSource":"https://www.guwendao.net/shiwenv_8616581bb564.aspx","note":"选原诗开头四句。","audio":"media/poems/p1a-j04.mp3","lineStarts":[0,1.2659,2.876,4.3017]},{"id":"p1a-j05","title":"风","author":"李峤","group":"一年级上册(日积月累)","grade":1,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_8bc9e1cc2b8f.aspx","lines":["解落三秋叶，","能开二月花。","过江千尺浪，","入竹万竿斜。"],"textSource":"https://www.guwendao.net/shiwenv_8bc9e1cc2b8f.aspx","audio":"media/poems/p1a-j05.mp3","lineStarts":[0,1.561,3.053,4.5679]},{"id":"p1b-k01","title":"静夜思","author":"李白","group":"一年级下册","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_c35a60c1a8e2.aspx","lines":["床前明月光，","疑是地上霜。","举头望明月，","低头思故乡。"],"textSource":"https://www.guwendao.net/shiwenv_c35a60c1a8e2.aspx","audio":"media/poems/p1b-k01.mp3","lineStarts":[0,1.4781,2.7337,4.1377]},{"id":"p1b-k02","title":"古对今","author":"车万育","group":"一年级下册","grade":1,"volume":"下","kind":"韵文","url":"https://www.guwendao.net/shiwenv_e99cfd986a47.aspx","lines":[],"textSource":"","note":"目录署车万育。此篇教材字句与清代《声律启蒙》原典的对应未获确认，暂收索引。"},{"id":"p1b-k03","title":"人之初","author":"王应麟","group":"一年级下册","grade":1,"volume":"下","kind":"韵文","url":"https://www.guwendao.net/shiwenv_63bcf81b5d09.aspx","lines":["人之初，性本善。","性相近，习相远。","苟不教，性乃迁。","教之道，贵以专。","子不学，非所宜。","幼不学，老何为。","玉不琢，不成器。","人不学，不知义。"],"textSource":"https://www.guwendao.net/shiwenv_63bcf81b5d09.aspx","note":"选自《三字经》；按目录所列的两个段落。","audio":"media/poems/p1b-k03.mp3","lineStarts":[0,2.0215,3.885,5.9131,7.7203,9.7271,11.5055,13.8612]},{"id":"p1b-k04","title":"池上","author":"白居易","group":"一年级下册","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_a8f44614071a.aspx","lines":["小娃撑小艇，","偷采白莲回。","不解藏踪迹，","浮萍一道开。"],"textSource":"https://www.guwendao.net/shiwenv_a8f44614071a.aspx","audio":"media/poems/p1b-k04.mp3","lineStarts":[0,1.3635,2.7622,4.1791]},{"id":"p1b-k05","title":"小池","author":"杨万里","group":"一年级下册","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_31dd7d07323c.aspx","lines":["泉眼无声惜细流，","树阴照水爱晴柔。","小荷才露尖尖角，","早有蜻蜓立上头。"],"textSource":"https://www.guwendao.net/shiwenv_31dd7d07323c.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p1b-k05.mp3","lineStarts":[0,2.148,4.5021,6.6242]},{"id":"p1b-j01","title":"春晓","author":"孟浩然","group":"一年级下册(日积月累)","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ccee5691ba93.aspx","lines":["春眠不觉晓，","处处闻啼鸟。","夜来风雨声，","花落知多少。"],"textSource":"https://www.guwendao.net/shiwenv_ccee5691ba93.aspx","audio":"media/poems/p1b-j01.mp3","lineStarts":[0,1.4013,2.7345,4.2332]},{"id":"p1b-j02","title":"寻隐者不遇","author":"贾岛","group":"一年级下册(日积月累)","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_40954072f541.aspx","lines":["松下问童子，","言师采药去。","只在此山中，","云深不知处。"],"textSource":"https://www.guwendao.net/shiwenv_40954072f541.aspx","audio":"media/poems/p1b-j02.mp3","lineStarts":[0,1.3923,2.9063,4.3067]},{"id":"p1b-j03","title":"赠汪伦","author":"李白","group":"一年级下册(日积月累)","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ca9eaf40a6ce.aspx","lines":["李白乘舟将欲行，","忽闻岸上踏歌声。","桃花潭水深千尺，","不及汪伦送我情。"],"textSource":"https://www.guwendao.net/shiwenv_ca9eaf40a6ce.aspx","audio":"media/poems/p1b-j03.mp3","lineStarts":[0,2.0361,3.8558,6.0191]},{"id":"p1b-j04","title":"画鸡","author":"唐寅","group":"一年级下册(日积月累)","grade":1,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_0f6ad3fb3d95.aspx","lines":["头上红冠不用裁，","满身雪白走将来。","平生不敢轻言语，","一叫千门万户开。"],"textSource":"https://www.guwendao.net/shiwenv_0f6ad3fb3d95.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p1b-j04.mp3","lineStarts":[0,1.7708,3.6971,5.438]},{"id":"p2a-k01","title":"登鹳雀楼","author":"王之涣","group":"二年级上册","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_c90ff9ea5a71.aspx","lines":["白日依山尽，","黄河入海流。","欲穷千里目，","更上一层楼。"],"textSource":"https://www.guwendao.net/shiwenv_c90ff9ea5a71.aspx","audio":"media/poems/p2a-k01.mp3","lineStarts":[0,1.614,3.1265,4.5267]},{"id":"p2a-k02","title":"望庐山瀑布","author":"李白","group":"二年级上册","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_62802abab937.aspx","lines":["日照香炉生紫烟，","遥看瀑布挂前川。","飞流直下三千尺，","疑是银河落九天。"],"textSource":"https://www.guwendao.net/shiwenv_62802abab937.aspx","audio":"media/poems/p2a-k02.mp3","lineStarts":[0,2.156,4.4693,6.6529]},{"id":"p2a-k03","title":"江雪","author":"柳宗元","group":"二年级上册","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_58313be2d918.aspx","lines":["千山鸟飞绝，","万径人踪灭。","孤舟蓑笠翁，","独钓寒江雪。"],"textSource":"https://www.guwendao.net/shiwenv_58313be2d918.aspx","audio":"media/poems/p2a-k03.mp3","lineStarts":[0,1.6789,3.1394,4.4475]},{"id":"p2a-k04","title":"敕勒歌","author":"佚名","group":"二年级上册","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f996111bff75.aspx","lines":["敕勒川，","阴山下。","天似穹庐，","笼盖四野。","天苍苍，","野茫茫，","风吹草低见牛羊。"],"textSource":"https://www.guwendao.net/shiwenv_f996111bff75.aspx","audio":"media/poems/p2a-k04.mp3","lineStarts":[0,1.1572,2.1219,3.3819,5.43,6.5842,7.6812]},{"id":"p2a-j01","title":"梅花","author":"王安石","group":"二年级上册(日积月累)","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_846e626d74d3.aspx","lines":["墙角数枝梅，","凌寒独自开。","遥知不是雪，","为有暗香来。"],"textSource":"https://www.guwendao.net/shiwenv_846e626d74d3.aspx","audio":"media/poems/p2a-j01.mp3","lineStarts":[0,1.5267,2.9927,4.5218]},{"id":"p2a-j02","title":"小儿垂钓","author":"胡令能","group":"二年级上册(日积月累)","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_200d28227643.aspx","lines":["蓬头稚子学垂纶，","侧坐莓苔草映身。","路人借问遥招手，","怕得鱼惊不应人。"],"textSource":"https://www.guwendao.net/shiwenv_200d28227643.aspx","audio":"media/poems/p2a-j02.mp3","lineStarts":[0,2.2154,4.0775,5.7762]},{"id":"p2a-j03","title":"夜宿山寺","author":"李白","group":"二年级上册(日积月累)","grade":2,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_85f036fcc038.aspx","lines":["危楼高百尺，","手可摘星辰。","不敢高声语，","恐惊天上人。"],"textSource":"https://www.guwendao.net/shiwenv_85f036fcc038.aspx","audio":"media/poems/p2a-j03.mp3","lineStarts":[0,1.6465,3.2057,4.3607]},{"id":"p2b-k01","title":"咏柳","author":"贺知章","group":"二年级下册","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_9936770100ef.aspx","lines":["碧玉妆成一树高，","万条垂下绿丝绦。","不知细叶谁裁出，","二月春风似剪刀。"],"textSource":"https://www.guwendao.net/shiwenv_9936770100ef.aspx","audio":"media/poems/p2b-k01.mp3","lineStarts":[0,1.9644,3.705,5.7545]},{"id":"p2b-k02","title":"村居","author":"高鼎","group":"二年级下册","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_425fb837c387.aspx","lines":["草长莺飞二月天，","拂堤杨柳醉春烟。","儿童散学归来早，","忙趁东风放纸鸢。"],"textSource":"https://www.guwendao.net/shiwenv_425fb837c387.aspx","audio":"media/poems/p2b-k02.mp3","lineStarts":[0,2.369,4.7603,6.4683]},{"id":"p2b-k03","title":"绝句","author":"杜甫","group":"二年级下册","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_549473b5211c.aspx","lines":["两个黄鹂鸣翠柳，","一行白鹭上青天。","窗含西岭千秋雪，","门泊东吴万里船。"],"textSource":"https://www.guwendao.net/shiwenv_549473b5211c.aspx","audio":"media/poems/p2b-k03.mp3","lineStarts":[0,1.8518,3.5269,5.7837]},{"id":"p2b-k04","title":"晓出净慈寺送林子方","author":"杨万里","group":"二年级下册","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_3ab4125fd0f1.aspx","lines":["毕竟西湖六月中，","风光不与四时同。","接天莲叶无穷碧，","映日荷花别样红。"],"textSource":"https://www.guwendao.net/shiwenv_3ab4125fd0f1.aspx","audio":"media/poems/p2b-k04.mp3","lineStarts":[0,1.8906,3.764,5.6318]},{"id":"p2b-j01","title":"赋得古原草送别(节选)","author":"白居易","group":"二年级下册(日积月累)","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ad8757771ddb.aspx","lines":["离离原上草，","一岁一枯荣。","野火烧不尽，","春风吹又生。"],"textSource":"https://www.guwendao.net/shiwenv_ad8757771ddb.aspx","note":"选原诗开头四句。","audio":"media/poems/p2b-j01.mp3","lineStarts":[0,1.4095,2.8719,4.2302]},{"id":"p2b-j02","title":"悯农二首·其一","author":"李绅","group":"二年级下册(日积月累)","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4859914a4e16.aspx","lines":["春种一粒粟，","秋收万颗子。","四海无闲田，","农夫犹饿死。"],"textSource":"https://www.guwendao.net/shiwenv_4859914a4e16.aspx","audio":"media/poems/p2b-j02.mp3","lineStarts":[0,1.3903,3.0748,4.5488]},{"id":"p2b-j03","title":"江上渔者","author":"范仲淹","group":"二年级下册(日积月累)","grade":2,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4b21381d3a76.aspx","lines":["江上往来人，","但爱鲈鱼美。","君看一叶舟，","出没风波里。"],"textSource":"https://www.guwendao.net/shiwenv_4b21381d3a76.aspx","audio":"media/poems/p2b-j03.mp3","lineStarts":[0,1.4063,2.8635,4.2211]},{"id":"p3a-k01","title":"望洞庭","author":"刘禹锡","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_880912218fc8.aspx","lines":["湖光秋月两相和，","潭面无风镜未磨。","遥望洞庭山水翠，","白银盘里一青螺。"],"textSource":"https://www.guwendao.net/shiwenv_880912218fc8.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p3a-k01.mp3","lineStarts":[0,1.9703,3.887,6.3154]},{"id":"p3a-k02","title":"山行","author":"杜牧","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_3c36881bd247.aspx","lines":["远上寒山石径斜，","白云生处有人家。","停车坐爱枫林晚，","霜叶红于二月花。"],"textSource":"https://www.guwendao.net/shiwenv_3c36881bd247.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p3a-k02.mp3","lineStarts":[0,2.0915,4.1155,5.7369]},{"id":"p3a-k03","title":"夜书所见","author":"叶绍翁","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_7ccd1778ba07.aspx","lines":["萧萧梧叶送寒声，","江上秋风动客情。","知有儿童挑促织，","夜深篱落一灯明。"],"textSource":"https://www.guwendao.net/shiwenv_7ccd1778ba07.aspx","audio":"media/poems/p3a-k03.mp3","lineStarts":[0,2.0057,3.9192,5.8028]},{"id":"p3a-k04","title":"鹿柴","author":"王维","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e9b1a8b4def0.aspx","lines":["空山不见人，","但闻人语响。","返景入深林，","复照青苔上。"],"textSource":"https://www.guwendao.net/shiwenv_e9b1a8b4def0.aspx","audio":"media/poems/p3a-k04.mp3","lineStarts":[0,1.5068,3.1607,4.9229]},{"id":"p3a-k05","title":"望天门山","author":"李白","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_97e6296bfb8d.aspx","lines":["天门中断楚江开，","碧水东流至此回。","两岸青山相对出，","孤帆一片日边来。"],"textSource":"https://www.guwendao.net/shiwenv_97e6296bfb8d.aspx","audio":"media/poems/p3a-k05.mp3","lineStarts":[0,2.0233,3.7644,5.4967]},{"id":"p3a-k06","title":"饮湖上初晴后雨","author":"苏轼","group":"三年级上册","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_8949464433f0.aspx","lines":["水光潋滟晴方好，","山色空蒙雨亦奇。","欲把西湖比西子，","淡妆浓抹总相宜。"],"textSource":"https://www.guwendao.net/shiwenv_8949464433f0.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p3a-k06.mp3","lineStarts":[0,2.3108,4.5075,6.2345]},{"id":"p3a-k07","title":"司马光","author":"脱脱等（《宋史》）","group":"三年级上册","grade":3,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_d08246ab36e2.aspx","lines":["群儿戏于庭，一儿登瓮，足跌没水中。","众皆弃去，光持石击瓮破之，水迸，儿得活。"],"textSource":"https://www.guwendao.net/shiwenv_d08246ab36e2.aspx","note":"节选自《宋史·司马光传》。","audio":"media/poems/p3a-k07.mp3","lineStarts":[0,4.3161]},{"id":"p3a-j01","title":"所见","author":"袁枚","group":"三年级上册(日积月累)","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_58699ebb5e93.aspx","lines":["牧童骑黄牛，","歌声振林樾。","意欲捕鸣蝉，","忽然闭口立。"],"textSource":"https://www.guwendao.net/shiwenv_58699ebb5e93.aspx","audio":"media/poems/p3a-j01.mp3","lineStarts":[0,1.3865,2.7745,4.3322]},{"id":"p3a-j02","title":"舟夜书所见","author":"查慎行","group":"三年级上册(日积月累)","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d88e3533fc4a.aspx","lines":["月黑见渔灯，","孤光一点萤。","微微风簇浪，","散作满河星。"],"textSource":"https://www.guwendao.net/shiwenv_d88e3533fc4a.aspx","audio":"media/poems/p3a-j02.mp3","lineStarts":[0,1.3649,2.8375,4.3238]},{"id":"p3a-j03","title":"早发白帝城","author":"李白","group":"三年级上册(日积月累)","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_0f81015a040c.aspx","lines":["朝辞白帝彩云间，","千里江陵一日还。","两岸猿声啼不住，","轻舟已过万重山。"],"textSource":"https://www.guwendao.net/shiwenv_0f81015a040c.aspx","audio":"media/poems/p3a-j03.mp3","lineStarts":[0,1.6915,3.5886,5.2625]},{"id":"p3a-j04","title":"采莲曲","author":"王昌龄","group":"三年级上册(日积月累)","grade":3,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_c953220f9f52.aspx","lines":["荷叶罗裙一色裁，","芙蓉向脸两边开。","乱入池中看不见，","闻歌始觉有人来。"],"textSource":"https://www.guwendao.net/shiwenv_c953220f9f52.aspx","audio":"media/poems/p3a-j04.mp3","lineStarts":[0,2.2482,4.3667,6.133]},{"id":"p3b-k01","title":"绝句","author":"杜甫","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e5e7911da1d2.aspx","lines":["迟日江山丽，","春风花草香。","泥融飞燕子，","沙暖睡鸳鸯。"],"textSource":"https://www.guwendao.net/shiwenv_e5e7911da1d2.aspx","audio":"media/poems/p3b-k01.mp3","lineStarts":[0,1.6496,3.1673,4.4862]},{"id":"p3b-k02","title":"惠崇春江晚景","author":"苏轼","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_cd140bf494da.aspx","lines":["竹外桃花三两枝，","春江水暖鸭先知。","蒌蒿满地芦芽短，","正是河豚欲上时。"],"textSource":"https://www.guwendao.net/shiwenv_cd140bf494da.aspx","audio":"media/poems/p3b-k02.mp3","lineStarts":[0,2.0965,3.9703,6.0315]},{"id":"p3b-k03","title":"三衢道中","author":"曾几","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_fbbd80710c5e.aspx","lines":["梅子黄时日日晴，","小溪泛尽却山行。","绿阴不减来时路，","添得黄鹂四五声。"],"textSource":"https://www.guwendao.net/shiwenv_fbbd80710c5e.aspx","audio":"media/poems/p3b-k03.mp3","lineStarts":[0,2.0863,4.1928,5.919]},{"id":"p3b-k04","title":"守株待兔","author":"韩非","group":"三年级下册","grade":3,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_bf758d053fca.aspx","lines":["宋人有耕者。","田中有株。","兔走触株，折颈而死。","因释其耒而守株，冀复得兔。","兔不可复得，而身为宋国笑。"],"textSource":"https://www.guwendao.net/shiwenv_bf758d053fca.aspx","audio":"media/poems/p3b-k04.mp3","lineStarts":[0,1.4844,2.729,4.8556,7.9976]},{"id":"p3b-k05","title":"元日","author":"王安石","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_a167901c9c90.aspx","lines":["爆竹声中一岁除，","春风送暖入屠苏。","千门万户曈曈日，","总把新桃换旧符。"],"textSource":"https://www.guwendao.net/shiwenv_a167901c9c90.aspx","audio":"media/poems/p3b-k05.mp3","lineStarts":[0,2.179,4.0373,5.9885]},{"id":"p3b-k06","title":"清明","author":"杜牧","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d3e3283daac5.aspx","lines":["清明时节雨纷纷，","路上行人欲断魂。","借问酒家何处有？","牧童遥指杏花村。"],"textSource":"https://www.guwendao.net/shiwenv_d3e3283daac5.aspx","audio":"media/poems/p3b-k06.mp3","lineStarts":[0,1.979,3.8193,5.4921]},{"id":"p3b-k07","title":"九月九日忆山东兄弟","author":"王维","group":"三年级下册","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d75a706935de.aspx","lines":["独在异乡为异客，","每逢佳节倍思亲。","遥知兄弟登高处，","遍插茱萸少一人。"],"textSource":"https://www.guwendao.net/shiwenv_d75a706935de.aspx","audio":"media/poems/p3b-k07.mp3","lineStarts":[0,1.8252,3.7551,5.8628]},{"id":"p3b-j01","title":"忆江南","author":"白居易","group":"三年级下册(日积月累)","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_6ad0636b01a9.aspx","lines":["江南好，","风景旧曾谙。","日出江花红胜火，","春来江水绿如蓝。","能不忆江南？"],"textSource":"https://www.guwendao.net/shiwenv_6ad0636b01a9.aspx","audio":"media/poems/p3b-j01.mp3","lineStarts":[0,1.0808,2.5248,4.5545,6.9676]},{"id":"p3b-j02","title":"滁州西涧","author":"韦应物","group":"三年级下册(日积月累)","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f6bd6356c843.aspx","lines":["独怜幽草涧边生，","上有黄鹂深树鸣。","春潮带雨晚来急，","野渡无人舟自横。"],"textSource":"https://www.guwendao.net/shiwenv_f6bd6356c843.aspx","audio":"media/poems/p3b-j02.mp3","lineStarts":[0,1.7473,3.9636,5.9504]},{"id":"p3b-j03","title":"大林寺桃花","author":"白居易","group":"三年级下册(日积月累)","grade":3,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_5e26797704a7.aspx","lines":["人间四月芳菲尽，","山寺桃花始盛开。","长恨春归无觅处，","不知转入此中来。"],"textSource":"https://www.guwendao.net/shiwenv_5e26797704a7.aspx","audio":"media/poems/p3b-j03.mp3","lineStarts":[0,1.9788,3.7753,5.7448]},{"id":"p4a-k01","title":"暮江吟","author":"白居易","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_0daa9748bcb5.aspx","lines":["一道残阳铺水中，","半江瑟瑟半江红。","可怜九月初三夜，","露似真珠月似弓。"],"textSource":"https://www.guwendao.net/shiwenv_0daa9748bcb5.aspx","audio":"media/poems/p4a-k01.mp3","lineStarts":[0,1.7004,3.6004,5.3655]},{"id":"p4a-k02","title":"题西林壁","author":"苏轼","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f2f5469a6044.aspx","lines":["横看成岭侧成峰，","远近高低各不同。","不识庐山真面目，","只缘身在此山中。"],"textSource":"https://www.guwendao.net/shiwenv_f2f5469a6044.aspx","audio":"media/poems/p4a-k02.mp3","lineStarts":[0,2.1045,3.8916,5.5263]},{"id":"p4a-k03","title":"雪梅","author":"卢钺","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_8f1be8b774c2.aspx","lines":["梅雪争春未肯降，","骚人阁笔费评章。","梅须逊雪三分白，","雪却输梅一段香。"],"textSource":"https://www.guwendao.net/shiwenv_8f1be8b774c2.aspx","audio":"media/poems/p4a-k03.mp3","lineStarts":[0,2.2722,4.1266,6.0803]},{"id":"p4a-k04","title":"精卫填海","author":"《山海经》","group":"四年级上册","grade":4,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_1104052ed0fc.aspx","lines":["炎帝之少女，名曰女娃。","女娃游于东海，溺而不返，故为精卫，常衔西山之木石，以堙于东海。"],"textSource":"https://www.guwendao.net/shiwenv_1104052ed0fc.aspx","audio":"media/poems/p4a-k04.mp3","lineStarts":[0,2.5264]},{"id":"p4a-k05","title":"王戎不取道旁李","author":"刘义庆","group":"四年级上册","grade":4,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_cfeddc2459c2.aspx","lines":["王戎七岁，尝与诸小儿游。","看道边李树多子折枝，诸儿竞走取之，唯戎不动。","人问之，答曰：“树在道边而多子，此必苦李。”","取之，信然。"],"textSource":"https://www.guwendao.net/shiwenv_cfeddc2459c2.aspx","audio":"media/poems/p4a-k05.mp3","lineStarts":[0,2.7262,7.2591,12.4618]},{"id":"p4a-k06","title":"凉州词","author":"王翰","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_9312f5349cd7.aspx","lines":["葡萄美酒夜光杯，","欲饮琵琶马上催。","醉卧沙场君莫笑，","古来征战几人回？"],"textSource":"https://www.guwendao.net/shiwenv_9312f5349cd7.aspx","audio":"media/poems/p4a-k06.mp3","lineStarts":[0,1.7662,3.8299,5.6597]},{"id":"p4a-k07","title":"出塞","author":"王昌龄","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_b9e14c6e09aa.aspx","lines":["秦时明月汉时关，","万里长征人未还。","但使龙城飞将在，","不教胡马度阴山。"],"textSource":"https://www.guwendao.net/shiwenv_b9e14c6e09aa.aspx","audio":"media/poems/p4a-k07.mp3","lineStarts":[0,2.1435,3.9894,5.5812]},{"id":"p4a-k08","title":"夏日绝句","author":"李清照","group":"四年级上册","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e4cd80aceb52.aspx","lines":["生当作人杰，","死亦为鬼雄。","至今思项羽，","不肯过江东。"],"textSource":"https://www.guwendao.net/shiwenv_e4cd80aceb52.aspx","audio":"media/poems/p4a-k08.mp3","lineStarts":[0,1.58,3.2301,4.719]},{"id":"p4a-j01","title":"赠刘景文","author":"苏轼","group":"四年级上册(日积月累)","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_c987db20a4d7.aspx","lines":["荷尽已无擎雨盖，","菊残犹有傲霜枝。","一年好景君须记，","最是橙黄橘绿时。"],"textSource":"https://www.guwendao.net/shiwenv_c987db20a4d7.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p4a-j01.mp3","lineStarts":[0,1.9462,3.8043,6.0124]},{"id":"p4a-j02","title":"嫦娥","author":"李商隐","group":"四年级上册(日积月累)","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_caef25db347c.aspx","lines":["云母屏风烛影深，","长河渐落晓星沉。","嫦娥应悔偷灵药，","碧海青天夜夜心。"],"textSource":"https://www.guwendao.net/shiwenv_caef25db347c.aspx","audio":"media/poems/p4a-j02.mp3","lineStarts":[0,2.0303,4.1166,5.8831]},{"id":"p4a-j03","title":"别董大","author":"高适","group":"四年级上册(日积月累)","grade":4,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4b3ccba01be6.aspx","lines":["千里黄云白日曛，","北风吹雁雪纷纷。","莫愁前路无知己，","天下谁人不识君。"],"textSource":"https://www.guwendao.net/shiwenv_4b3ccba01be6.aspx","audio":"media/poems/p4a-j03.mp3","lineStarts":[0,2.227,4.2035,6.097]},{"id":"p4b-k01","title":"四时田园杂兴","author":"范成大","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_6e4b9596b2f3.aspx","lines":["梅子金黄杏子肥，","麦花雪白菜花稀。","日长篱落无人过，","惟有蜻蜓蛱蝶飞。"],"textSource":"https://www.guwendao.net/shiwenv_6e4b9596b2f3.aspx","note":"篇目表使用简称，链接所指为《四时田园杂兴·其二十五》。","audio":"media/poems/p4b-k01.mp3","lineStarts":[0,2.3751,4.3526,6.2798]},{"id":"p4b-k02","title":"宿新市徐公店","author":"杨万里","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f92fb36ff846.aspx","lines":["篱落疏疏一径深，","树头新绿未成阴。","儿童急走追黄蝶，","飞入菜花无处寻。"],"textSource":"https://www.guwendao.net/shiwenv_f92fb36ff846.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p4b-k02.mp3","lineStarts":[0,1.8863,3.849,5.9935]},{"id":"p4b-k03","title":"清平乐·村居","author":"辛弃疾","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_03e80e28a0c2.aspx","lines":["茅檐低小，","溪上青青草。","醉里吴音相媚好，","白发谁家翁媪？","大儿锄豆溪东，","中儿正织鸡笼。","最喜小儿亡赖，","溪头卧剥莲蓬。"],"textSource":"https://www.guwendao.net/shiwenv_03e80e28a0c2.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p4b-k03.mp3","lineStarts":[0,1.2457,2.7559,4.86,6.4145,8.0186,9.5988,11.1424]},{"id":"p4b-k04","title":"芙蓉楼送辛渐","author":"王昌龄","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f433a64dd504.aspx","lines":["寒雨连江夜入吴，","平明送客楚山孤。","洛阳亲友如相问，","一片冰心在玉壶。"],"textSource":"https://www.guwendao.net/shiwenv_f433a64dd504.aspx","audio":"media/poems/p4b-k04.mp3","lineStarts":[0,2.0878,4.046,5.9815]},{"id":"p4b-k05","title":"塞下曲","author":"卢纶","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_9a9463173105.aspx","lines":["月黑雁飞高，","单于夜遁逃。","欲将轻骑逐，","大雪满弓刀。"],"textSource":"https://www.guwendao.net/shiwenv_9a9463173105.aspx","audio":"media/poems/p4b-k05.mp3","lineStarts":[0,1.3659,2.9337,4.8592]},{"id":"p4b-k06","title":"墨梅","author":"王冕","group":"四年级下册","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_82fd6027caf3.aspx","lines":["我家洗砚池头树，","朵朵花开淡墨痕。","不要人夸好颜色，","只留清气满乾坤。"],"textSource":"https://www.guwendao.net/shiwenv_82fd6027caf3.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p4b-k06.mp3","lineStarts":[0,1.7548,3.8595,5.4681]},{"id":"p4b-k07","title":"囊萤夜读","author":"房玄龄等（《晋书》）","group":"四年级下册","grade":4,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_a640d462c006.aspx","lines":["胤恭勤不倦，博学多通。","家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。"],"textSource":"https://www.guwendao.net/shiwenv_a640d462c006.aspx","note":"节选自《晋书·车胤传》。","audio":"media/poems/p4b-k07.mp3","lineStarts":[0,2.6422]},{"id":"p4b-k08","title":"铁杵成针","author":"祝穆","group":"四年级下册","grade":4,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_9236b601a746.aspx","lines":["磨针溪，在象耳山下。","世传李太白读书山中，未成，弃去。","过是溪，逢老媪方磨铁杵。","问之，曰：“欲作针。”","太白感其意，还卒业。"],"textSource":"https://www.guwendao.net/shiwenv_9236b601a746.aspx","audio":"media/poems/p4b-k08.mp3","lineStarts":[0,2.2379,5.8593,8.7703,11.353]},{"id":"p4b-j01","title":"卜算子·咏梅","author":"毛泽东","group":"四年级下册(日积月累)","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e8c610c2308b.aspx","lines":[],"textSource":"","note":"此处为毛泽东作品，暂收索引。"},{"id":"p4b-j02","title":"江畔独步寻花","author":"杜甫","group":"四年级下册(日积月累)","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_85e46c4b3dbc.aspx","lines":["黄师塔前江水东，","春光懒困倚微风。","桃花一簇开无主，","可爱深红爱浅红？"],"textSource":"https://www.guwendao.net/shiwenv_85e46c4b3dbc.aspx","note":"篇目表使用简称，链接所指为《江畔独步寻花·其五》。","audio":"media/poems/p4b-j02.mp3","lineStarts":[0,1.9196,3.9103,5.8471]},{"id":"p4b-j03","title":"蜂","author":"罗隐","group":"四年级下册(日积月累)","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_0cf974c0b70a.aspx","lines":["不论平地与山尖，","无限风光尽被占。","采得百花成蜜后，","为谁辛苦为谁甜？"],"textSource":"https://www.guwendao.net/shiwenv_0cf974c0b70a.aspx","audio":"media/poems/p4b-j03.mp3","lineStarts":[0,1.6851,3.4068,5.3001]},{"id":"p4b-j04","title":"独坐敬亭山","author":"李白","group":"四年级下册(日积月累)","grade":4,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_1da5349ad9e4.aspx","lines":["众鸟高飞尽，","孤云独去闲。","相看两不厌，","只有敬亭山。"],"textSource":"https://www.guwendao.net/shiwenv_1da5349ad9e4.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p4b-j04.mp3","lineStarts":[0,1.4455,2.9528,4.1804]},{"id":"p5a-k01","title":"示儿","author":"陆游","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_966c8a76211f.aspx","lines":["死去元知万事空，","但悲不见九州同。","王师北定中原日，","家祭无忘告乃翁。"],"textSource":"https://www.guwendao.net/shiwenv_966c8a76211f.aspx","audio":"media/poems/p5a-k01.mp3","lineStarts":[0,1.9353,3.7963,5.6846]},{"id":"p5a-k02","title":"题临安邸","author":"林升","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_63f2cb1073ff.aspx","lines":["山外青山楼外楼，","西湖歌舞几时休？","暖风熏得游人醉，","直把杭州作汴州。"],"textSource":"https://www.guwendao.net/shiwenv_63f2cb1073ff.aspx","audio":"media/poems/p5a-k02.mp3","lineStarts":[0,1.9494,3.7982,5.7231]},{"id":"p5a-k03","title":"己亥杂诗","author":"龚自珍","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_838d9b401572.aspx","lines":["九州生气恃风雷，","万马齐喑究可哀。","我劝天公重抖擞，","不拘一格降人材。"],"textSource":"https://www.guwendao.net/shiwenv_838d9b401572.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p5a-k03.mp3","lineStarts":[0,2.0002,3.8444,6.0998]},{"id":"p5a-k04","title":"少年中国说(节选)","author":"梁启超","group":"五年级上册","grade":5,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_9ebe5eef393d.aspx","lines":["故今日之责任，不在他人，而全在我少年。","少年智则国智，少年富则国富；","少年强则国强，少年独立则国独立；","少年自由则国自由；","少年进步则国进步；","少年胜于欧洲，则国胜于欧洲；","少年雄于地球，则国雄于地球。","红日初升，其道大光。","河出伏流，一泻汪洋。","潜龙腾渊，鳞爪飞扬。","乳虎啸谷，百兽震惶。","鹰隼试翼，风尘吸张。","奇花初胎，矞矞皇皇。","干将发硎，有作其芒。","天戴其苍，地履其黄。","纵有千古，横有八荒。","前途似海，来日方长。","美哉，我少年中国，与天不老！","壮哉，我中国少年，与国无疆！"],"textSource":"https://www.guwendao.net/shiwenv_9ebe5eef393d.aspx","note":"取梁启超《少年中国说》目录所链接的节选。","audio":"media/poems/p5a-k04.mp3","lineStarts":[0,3.8987,7.3266,11.1986,13.4393,15.6289,18.6926,22.2175,24.7375,27.0815,29.6078,32.1108,34.4378,36.9179,39.7119,42.0593,44.3422,46.4985,49.175]},{"id":"p5a-k05","title":"山居秋暝","author":"王维","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_44ba4afb80db.aspx","lines":["空山新雨后，","天气晚来秋。","明月松间照，","清泉石上流。","竹喧归浣女，","莲动下渔舟。","随意春芳歇，","王孙自可留。"],"textSource":"https://www.guwendao.net/shiwenv_44ba4afb80db.aspx","audio":"media/poems/p5a-k05.mp3","lineStarts":[0,1.3153,2.688,4.0553,5.7327,7.1094,8.4869,9.8501]},{"id":"p5a-k06","title":"枫桥夜泊","author":"张继","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_6fb73f607ad3.aspx","lines":["月落乌啼霜满天，","江枫渔火对愁眠。","姑苏城外寒山寺，","夜半钟声到客船。"],"textSource":"https://www.guwendao.net/shiwenv_6fb73f607ad3.aspx","audio":"media/poems/p5a-k06.mp3","lineStarts":[0,2.062,4.0923,5.8888]},{"id":"p5a-k07","title":"早春呈水部张十八员外","author":"韩愈","group":"五年级上册","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_7e09f12b287c.aspx","lines":["天街小雨润如酥，","草色遥看近却无。","最是一年春好处，","绝胜烟柳满皇都。"],"textSource":"https://www.guwendao.net/shiwenv_7e09f12b287c.aspx","audio":"media/poems/p5a-k07.mp3","lineStarts":[0,2.2147,4.1068,5.8352]},{"id":"p5a-k08","title":"古人谈读书","author":"《论语》、朱熹","group":"五年级上册","grade":5,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_04f7c4ccfa13.aspx","lines":["知之为知之，不知为不知，是知也。","敏而好学，不耻下问。","默而识之，学而不厌，诲人不倦。","我非生而知之者，好古，敏以求之者也。","吾尝终日不食，终夜不寝，以思，无益，不如学也。","余尝谓读书有三到，谓心到、眼到、口到。","心不在此，则眼不看仔细，心眼既不专一，却只漫浪诵读，决不能记，记亦不能久也。","三到之中，心到最急。","心既到矣，眼口岂不到乎？"],"textSource":"https://www.guwendao.net/shiwenv_04f7c4ccfa13.aspx","note":"按链接所列两部分，依次选《论语》及朱熹《训学斋规》。","audio":"media/poems/p5a-k08.mp3","lineStarts":[0,3.3808,5.4714,8.8498,13.0358,17.7782,22.0427,29.8348,32.1449]},{"id":"p5a-j01","title":"乞巧","author":"林杰","group":"五年级上册(日积月累)","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e152d043be94.aspx","lines":["七夕今宵看碧霄，","牵牛织女渡河桥。","家家乞巧望秋月，","穿尽红丝几万条。"],"textSource":"https://www.guwendao.net/shiwenv_e152d043be94.aspx","audio":"media/poems/p5a-j01.mp3","lineStarts":[0,2.2532,4.1947,5.9155]},{"id":"p5a-j02","title":"游子吟","author":"孟郊","group":"五年级上册(日积月累)","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_161d06b0b556.aspx","lines":["慈母手中线，","游子身上衣。","临行密密缝，","意恐迟迟归。","谁言寸草心，","报得三春晖。"],"textSource":"https://www.guwendao.net/shiwenv_161d06b0b556.aspx","audio":"media/poems/p5a-j02.mp3","lineStarts":[0,1.5159,2.95,4.4978,6.0111,7.6868]},{"id":"p5a-j03","title":"渔歌子","author":"张志和","group":"五年级上册(日积月累)","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ee72baa043c8.aspx","lines":["西塞山前白鹭飞，","桃花流水鳜鱼肥。","青箬笠，","绿蓑衣，","斜风细雨不须归。"],"textSource":"https://www.guwendao.net/shiwenv_ee72baa043c8.aspx","note":"篇目表使用简称，链接所指为《渔歌子·西塞山前白鹭飞》。","audio":"media/poems/p5a-j03.mp3","lineStarts":[0,2.1384,4.4943,5.6285,6.7005]},{"id":"p5a-j04","title":"观书有感·其一","author":"朱熹","group":"五年级上册(日积月累)","grade":5,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4c1364cb1da5.aspx","lines":["半亩方塘一鉴开，","天光云影共徘徊。","问渠那得清如许？","为有源头活水来。"],"textSource":"https://www.guwendao.net/shiwenv_4c1364cb1da5.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p5a-j04.mp3","lineStarts":[0,2.0686,4.0141,5.8799]},{"id":"p5b-k01","title":"四时田园杂兴·其三十一","author":"范成大","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_9d5e3f5ee21f.aspx","lines":["昼出耘田夜绩麻，","村庄儿女各当家。","童孙未解供耕织，","也傍桑阴学种瓜。"],"textSource":"https://www.guwendao.net/shiwenv_9d5e3f5ee21f.aspx","audio":"media/poems/p5b-k01.mp3","lineStarts":[0,2.2263,4.1859,6.0616]},{"id":"p5b-k02","title":"稚子弄冰","author":"杨万里","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4bb194abd528.aspx","lines":["稚子金盆脱晓冰，","彩丝穿取当银钲。","敲成玉磬穿林响，","忽作玻璃碎地声。"],"textSource":"https://www.guwendao.net/shiwenv_4bb194abd528.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p5b-k02.mp3","lineStarts":[0,1.7263,3.5923,5.4791]},{"id":"p5b-k03","title":"村晚","author":"雷震","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_be04bba6288c.aspx","lines":["草满池塘水满陂，","山衔落日浸寒漪。","牧童归去横牛背，","短笛无腔信口吹。"],"textSource":"https://www.guwendao.net/shiwenv_be04bba6288c.aspx","audio":"media/poems/p5b-k03.mp3","lineStarts":[0,2.0666,4.405,6.2433]},{"id":"p5b-k04","title":"从军行七首·其四","author":"王昌龄","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d1129db241ec.aspx","lines":["青海长云暗雪山，","孤城遥望玉门关。","黄沙百战穿金甲，","不破楼兰终不还。"],"textSource":"https://www.guwendao.net/shiwenv_d1129db241ec.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p5b-k04.mp3","lineStarts":[0,2.1415,3.9936,6.1153]},{"id":"p5b-k05","title":"秋夜将晓出篱门迎凉有感","author":"陆游","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_dbabcfab1a1b.aspx","lines":["三万里河东入海，","五千仞岳上摩天。","遗民泪尽胡尘里，","南望王师又一年。"],"textSource":"https://www.guwendao.net/shiwenv_dbabcfab1a1b.aspx","note":"篇目表使用简称，链接所指为《秋夜将晓出篱门迎凉有感二首·其二》。","audio":"media/poems/p5b-k05.mp3","lineStarts":[0,1.7965,3.747,5.7392]},{"id":"p5b-k06","title":"闻官军收河南河北","author":"杜甫","group":"五年级下册","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_519029b7355c.aspx","lines":["剑外忽传收蓟北，","初闻涕泪满衣裳。","却看妻子愁何在，","漫卷诗书喜欲狂。","白日放歌须纵酒，","青春作伴好还乡。","即从巴峡穿巫峡，","便下襄阳向洛阳。"],"textSource":"https://www.guwendao.net/shiwenv_519029b7355c.aspx","audio":"media/poems/p5b-k06.mp3","lineStarts":[0,2.0786,3.9311,5.7282,8.5317,10.4554,12.5781,14.5365]},{"id":"p5b-k07","title":"自相矛盾","author":"韩非","group":"五年级下册","grade":5,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_d52e05980359.aspx","lines":["楚人有鬻盾与矛者，誉之曰：“吾盾之坚，物莫能陷也。”","又誉其矛曰：“吾矛之利，于物无不陷也。”","或曰：“以子之矛陷子之盾，何如？”","其人弗能应也。","夫不可陷之盾与无不陷之矛，不可同世而立。"],"textSource":"https://www.guwendao.net/shiwenv_d52e05980359.aspx","audio":"media/poems/p5b-k07.mp3","lineStarts":[0,5.1229,9.4666,12.8726,14.3866]},{"id":"p5b-k08","title":"杨氏之子","author":"刘义庆","group":"五年级下册","grade":5,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_af4715c0208f.aspx","lines":["梁国杨氏子九岁，甚聪惠。","孔君平诣其父，父不在，乃呼儿出。","为设果，果有杨梅。","孔指以示儿曰：“此是君家果。”","儿应声答曰：“未闻孔雀是夫子家禽。”"],"textSource":"https://www.guwendao.net/shiwenv_af4715c0208f.aspx","audio":"media/poems/p5b-k08.mp3","lineStarts":[0,2.8942,6.6219,8.6524,12.514]},{"id":"p5b-j01","title":"游子吟","author":"孟郊","group":"五年级下册(日积月累)","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_161d06b0b556.aspx","lines":["慈母手中线，","游子身上衣。","临行密密缝，","意恐迟迟归。","谁言寸草心，","报得三春晖。"],"textSource":"https://www.guwendao.net/shiwenv_161d06b0b556.aspx","audio":"media/poems/p5b-j01.mp3","lineStarts":[0,1.5159,2.95,4.4978,6.0111,7.6868]},{"id":"p5b-j02","title":"鸟鸣涧","author":"王维","group":"五年级下册(日积月累)","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_8ec950bd1395.aspx","lines":["人闲桂花落，","夜静春山空。","月出惊山鸟，","时鸣春涧中。"],"textSource":"https://www.guwendao.net/shiwenv_8ec950bd1395.aspx","audio":"media/poems/p5b-j02.mp3","lineStarts":[0,1.3373,2.8191,4.4708]},{"id":"p5b-j03","title":"凉州词二首·其一","author":"王之涣","group":"五年级下册(日积月累)","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_3963afd966bc.aspx","lines":["黄河远上白云间，","一片孤城万仞山。","羌笛何须怨杨柳，","春风不度玉门关。"],"textSource":"https://www.guwendao.net/shiwenv_3963afd966bc.aspx","audio":"media/poems/p5b-j03.mp3","lineStarts":[0,2.3006,4.1022,6.297]},{"id":"p5b-j04","title":"黄鹤楼送孟浩然之广陵","author":"李白","group":"五年级下册(日积月累)","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d3f231047aef.aspx","lines":["故人西辞黄鹤楼，","烟花三月下扬州。","孤帆远影碧空尽，","唯见长江天际流。"],"textSource":"https://www.guwendao.net/shiwenv_d3f231047aef.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p5b-j04.mp3","lineStarts":[0,2.0202,3.9584,5.768]},{"id":"p5b-j05","title":"乡村四月","author":"翁卷","group":"五年级下册(日积月累)","grade":5,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_07f5e3403665.aspx","lines":["绿遍山原白满川，","子规声里雨如烟。","乡村四月闲人少，","才了蚕桑又插田。"],"textSource":"https://www.guwendao.net/shiwenv_07f5e3403665.aspx","audio":"media/poems/p5b-j05.mp3","lineStarts":[0,2.1721,4.0525,5.8065]},{"id":"p6a-k01","title":"宿建德江","author":"孟浩然","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_63d3ff8f6b61.aspx","lines":["移舟泊烟渚，","日暮客愁新。","野旷天低树，","江清月近人。"],"textSource":"https://www.guwendao.net/shiwenv_63d3ff8f6b61.aspx","audio":"media/poems/p6a-k01.mp3","lineStarts":[0,1.454,2.9598,4.63]},{"id":"p6a-k02","title":"六月二十七日望湖楼醉书","author":"苏轼","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_0eda7b78250a.aspx","lines":["黑云翻墨未遮山，","白雨跳珠乱入船。","卷地风来忽吹散，","望湖楼下水如天。"],"textSource":"https://www.guwendao.net/shiwenv_0eda7b78250a.aspx","audio":"media/poems/p6a-k02.mp3","lineStarts":[0,2.109,4.4211,6.3079]},{"id":"p6a-k03","title":"西江月·夜行黄沙道中","author":"辛弃疾","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f090d65212f4.aspx","lines":["明月别枝惊鹊，","清风半夜鸣蝉。","稻花香里说丰年，","听取蛙声一片。","七八个星天外，","两三点雨山前。","旧时茅店社林边，","路转溪桥忽见。"],"textSource":"https://www.guwendao.net/shiwenv_f090d65212f4.aspx","audio":"media/poems/p6a-k03.mp3","lineStarts":[0,1.6502,3.5224,5.5739,7.1372,8.5405,10.4288,12.417]},{"id":"p6a-k04","title":"七律·长征","author":"毛泽东","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_a1e7559dada7.aspx","lines":[],"textSource":"","note":"近现代作品，暂收索引。"},{"id":"p6a-k05","title":"浪淘沙·其一","author":"刘禹锡","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_857567307e6a.aspx","lines":["九曲黄河万里沙，","浪淘风簸自天涯。","如今直上银河去，","同到牵牛织女家。"],"textSource":"https://www.guwendao.net/shiwenv_857567307e6a.aspx","audio":"media/poems/p6a-k05.mp3","lineStarts":[0,1.8055,4.2849,6.0129]},{"id":"p6a-k06","title":"江南春","author":"杜牧","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_33cbdb2cf9b3.aspx","lines":["千里莺啼绿映红，","水村山郭酒旗风。","南朝四百八十寺，","多少楼台烟雨中。"],"textSource":"https://www.guwendao.net/shiwenv_33cbdb2cf9b3.aspx","audio":"media/poems/p6a-k06.mp3","lineStarts":[0,2.052,4.1126,5.8885]},{"id":"p6a-k07","title":"书湖阴先生壁","author":"王安石","group":"六年级上册","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_3d787de04152.aspx","lines":["茅檐长扫净无苔，","花木成畦手自栽。","一水护田将绿绕，","两山排闼送青来。"],"textSource":"https://www.guwendao.net/shiwenv_3d787de04152.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6a-k07.mp3","lineStarts":[0,2.9044,4.9114,6.7315]},{"id":"p6a-k08","title":"两小儿辩日","author":"列子","group":"六年级上册","grade":6,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_b4a451fa375a.aspx","lines":["孔子东游，见两小儿辩斗，问其故。","一儿曰：“我以日始出时去人近，而日中时远也。”","一儿曰：“我以日初出远，而日中时近也。”","一儿曰：“日初出大如车盖，及日中则如盘盂，此不为远者小而近者大乎？”","一儿曰：“日初出沧沧凉凉，及其日中如探汤，此不为近者热而远者凉乎？”","孔子不能决也。","两小儿笑曰：“孰为汝多知乎？”"],"textSource":"https://www.guwendao.net/shiwenv_b4a451fa375a.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6a-k08.mp3","lineStarts":[0,3.3385,8.2528,12.1755,19.0973,26.2995,27.8621]},{"id":"p6a-k09","title":"曹冲称象","author":"陈寿","group":"六年级上册","grade":6,"volume":"上","kind":"古文","url":"https://www.guwendao.net/shiwenv_31b814913b16.aspx","lines":["邓哀王冲字仓舒，少聪察岐嶷，生五六岁，智意所及，有若成人之智。","时孙权曾致巨象，太祖欲知其斤重，访之群下，咸莫能出其理。","冲曰：“置象大船之上，而刻其水痕所至，称物以载之，则校可知矣。”","太祖大悦，即施行焉。"],"textSource":"https://www.guwendao.net/shiwenv_31b814913b16.aspx","note":"取《三国志·魏书·邓哀王冲传》文言段落。","audio":"media/poems/p6a-k09.mp3","lineStarts":[0,6.7445,13.7943,19.9405]},{"id":"p6a-j01","title":"江畔独步寻花·其五","author":"杜甫","group":"六年级上册(日积月累)","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_85e46c4b3dbc.aspx","lines":["黄师塔前江水东，","春光懒困倚微风。","桃花一簇开无主，","可爱深红爱浅红？"],"textSource":"https://www.guwendao.net/shiwenv_85e46c4b3dbc.aspx","audio":"media/poems/p6a-j01.mp3","lineStarts":[0,1.9196,3.9103,5.8471]},{"id":"p6a-j02","title":"观书有感·其二","author":"朱熹","group":"六年级上册(日积月累)","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_dd1c97accf6e.aspx","lines":["昨夜江边春水生，","蒙冲巨舰一毛轻。","向来枉费推移力，","此日中流自在行。"],"textSource":"https://www.guwendao.net/shiwenv_dd1c97accf6e.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6a-j02.mp3","lineStarts":[0,1.8518,3.6166,5.5134]},{"id":"p6a-j03","title":"送元二使安西","author":"王维","group":"六年级上册(日积月累)","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_12a2295aa76b.aspx","lines":["渭城朝雨浥轻尘，","客舍青青柳色新。","劝君更尽一杯酒，","西出阳关无故人。"],"textSource":"https://www.guwendao.net/shiwenv_12a2295aa76b.aspx","audio":"media/poems/p6a-j03.mp3","lineStarts":[0,1.9883,3.9225,5.6775]},{"id":"p6a-j04","title":"过故人庄","author":"孟浩然","group":"六年级上册(日积月累)","grade":6,"volume":"上","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4a0d548bebb3.aspx","lines":["故人具鸡黍，","邀我至田家。","绿树村边合，","青山郭外斜。","开轩面场圃，","把酒话桑麻。","待到重阳日，","还来就菊花。"],"textSource":"https://www.guwendao.net/shiwenv_4a0d548bebb3.aspx","audio":"media/poems/p6a-j04.mp3","lineStarts":[0,1.4746,2.8047,4.5183,6.2114,7.7114,9.2526,10.9557]},{"id":"p6b-k01","title":"寒食","author":"韩翃","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_f26e62f4bfc8.aspx","lines":["春城无处不飞花，","寒食东风御柳斜。","日暮汉宫传蜡烛，","轻烟散入五侯家。"],"textSource":"https://www.guwendao.net/shiwenv_f26e62f4bfc8.aspx","audio":"media/poems/p6b-k01.mp3","lineStarts":[0,2.0194,4.0705,6.0479]},{"id":"p6b-k02","title":"迢迢牵牛星","author":"佚名","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_7f09a756c9c0.aspx","lines":["迢迢牵牛星，","皎皎河汉女。","纤纤擢素手，","札札弄机杼。","终日不成章，","泣涕零如雨。","河汉清且浅，","相去复几许。","盈盈一水间，","脉脉不得语。"],"textSource":"https://www.guwendao.net/shiwenv_7f09a756c9c0.aspx","audio":"media/poems/p6b-k02.mp3","lineStarts":[0,1.2917,2.9566,4.4028,5.8814,7.1038,8.5702,10.1499,11.686,13.1683]},{"id":"p6b-k03","title":"十五夜望月","author":"王建","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_2367f5ae6dee.aspx","lines":["中庭地白树栖鸦，","冷露无声湿桂花。","今夜月明人尽望，","不知秋思落谁家。"],"textSource":"https://www.guwendao.net/shiwenv_2367f5ae6dee.aspx","audio":"media/poems/p6b-k03.mp3","lineStarts":[0,2.1119,4.8267,6.7998]},{"id":"p6b-k04","title":"马诗","author":"李贺","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_55174e6ebe20.aspx","lines":["大漠沙如雪，","燕山月似钩。","何当金络脑，","快走踏清秋。"],"textSource":"https://www.guwendao.net/shiwenv_55174e6ebe20.aspx","note":"篇目表使用简称，链接所指为《马诗二十三首·其五》。","audio":"media/poems/p6b-k04.mp3","lineStarts":[0,1.5599,3.3737,5.4431]},{"id":"p6b-k05","title":"石灰吟","author":"于谦","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_c6c93895df0a.aspx","lines":["千锤万凿出深山，","烈火焚烧若等闲。","粉骨碎身浑不怕，","要留清白在人间。"],"textSource":"https://www.guwendao.net/shiwenv_c6c93895df0a.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6b-k05.mp3","lineStarts":[0,2.0125,4.1946,6.1302]},{"id":"p6b-k06","title":"竹石","author":"郑燮","group":"六年级下册","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_e5c9337524b7.aspx","lines":["咬定青山不放松，","立根原在破岩中。","千磨万击还坚劲，","任尔东西南北风。"],"textSource":"https://www.guwendao.net/shiwenv_e5c9337524b7.aspx","note":"目录署郑燮，详情署郑板桥，为同一人。","audio":"media/poems/p6b-k06.mp3","lineStarts":[0,1.7147,3.4971,5.502]},{"id":"p6b-k07","title":"学弈","author":"孟子","group":"六年级下册","grade":6,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_7dddb391682f.aspx","lines":["弈秋，通国之善弈者也。","使弈秋诲二人弈，其一人专心致志，惟弈秋之为听；","一人虽听之，一心以为有鸿鹄将至，思援弓缴而射之。","虽与之俱学，弗若之矣。","为是其智弗若与？","曰：非然也。"],"textSource":"https://www.guwendao.net/shiwenv_7dddb391682f.aspx","audio":"media/poems/p6b-k07.mp3","lineStarts":[0,2.5783,7.6763,13.0988,15.6279,17.585]},{"id":"p6b-k08","title":"两小儿辩日","author":"列御寇","group":"六年级下册","grade":6,"volume":"下","kind":"古文","url":"https://www.guwendao.net/shiwenv_b4a451fa375a.aspx","lines":["孔子东游，见两小儿辩斗，问其故。","一儿曰：“我以日始出时去人近，而日中时远也。”","一儿曰：“我以日初出远，而日中时近也。”","一儿曰：“日初出大如车盖，及日中则如盘盂，此不为远者小而近者大乎？”","一儿曰：“日初出沧沧凉凉，及其日中如探汤，此不为近者热而远者凉乎？”","孔子不能决也。","两小儿笑曰：“孰为汝多知乎？”"],"textSource":"https://www.guwendao.net/shiwenv_b4a451fa375a.aspx","note":"目录此处署列御寇，链接与六年级上册同一篇。","audio":"media/poems/p6b-k08.mp3","lineStarts":[0,3.3385,8.2528,12.1755,19.0973,26.2995,27.8621]},{"id":"p6b-j01","title":"长歌行","author":"汉乐府","group":"六年级下册(日积月累)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_183d69f50755.aspx","lines":["青青园中葵，","朝露待日晞。","阳春布德泽，","万物生光辉。","常恐秋节至，","焜黄华叶衰。","百川东到海，","何时复西归？","少壮不努力，","老大徒伤悲！"],"textSource":"https://www.guwendao.net/shiwenv_183d69f50755.aspx","audio":"media/poems/p6b-j01.mp3","lineStarts":[0,1.4261,2.8849,4.392,5.903,7.4912,8.9973,10.5192,11.8943,13.2644]},{"id":"p6b-s01","title":"采薇(节选)","author":"佚名（《诗经》）","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_fa087546c81b.aspx","lines":["昔我往矣，","杨柳依依。","今我来思，","雨雪霏霏。","行道迟迟，","载渴载饥。","我心伤悲，","莫知我哀！"],"textSource":"https://www.guwendao.net/shiwenv_fa087546c81b.aspx","note":"选《诗经·小雅·采薇》末章。","audio":"media/poems/p6b-s01.mp3","lineStarts":[0,1.2561,2.6357,3.8607,5.0695,6.4002,7.7899,9.0467]},{"id":"p6b-s02","title":"送元二使安西","author":"王维","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_12a2295aa76b.aspx","lines":["渭城朝雨浥轻尘，","客舍青青柳色新。","劝君更尽一杯酒，","西出阳关无故人。"],"textSource":"https://www.guwendao.net/shiwenv_12a2295aa76b.aspx","audio":"media/poems/p6b-s02.mp3","lineStarts":[0,1.9883,3.9225,5.6775]},{"id":"p6b-s03","title":"春夜喜雨","author":"杜甫","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_d48451f00541.aspx","lines":["好雨知时节，","当春乃发生。","随风潜入夜，","润物细无声。","野径云俱黑，","江船火独明。","晓看红湿处，","花重锦官城。"],"textSource":"https://www.guwendao.net/shiwenv_d48451f00541.aspx","audio":"media/poems/p6b-s03.mp3","lineStarts":[0,1.4509,2.8194,4.3714,5.7378,7.7898,9.3068,10.8241]},{"id":"p6b-s04","title":"早春呈水部张十八员外","author":"韩愈","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_7e09f12b287c.aspx","lines":["天街小雨润如酥，","草色遥看近却无。","最是一年春好处，","绝胜烟柳满皇都。"],"textSource":"https://www.guwendao.net/shiwenv_7e09f12b287c.aspx","audio":"media/poems/p6b-s04.mp3","lineStarts":[0,2.2147,4.1068,5.8352]},{"id":"p6b-s05","title":"江上渔者","author":"范仲淹","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_4b21381d3a76.aspx","lines":["江上往来人，","但爱鲈鱼美。","君看一叶舟，","出没风波里。"],"textSource":"https://www.guwendao.net/shiwenv_4b21381d3a76.aspx","audio":"media/poems/p6b-s05.mp3","lineStarts":[0,1.4063,2.8635,4.2211]},{"id":"p6b-s06","title":"泊船瓜洲","author":"王安石","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_df14e6fd217b.aspx","lines":["京口瓜洲一水间，","钟山只隔数重山。","春风又绿江南岸，","明月何时照我还。"],"textSource":"https://www.guwendao.net/shiwenv_df14e6fd217b.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6b-s06.mp3","lineStarts":[0,2.33,4.1961,6.8549]},{"id":"p6b-s07","title":"游园不值","author":"叶绍翁","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_a31b957aba53.aspx","lines":["应怜屐齿印苍苔，","小扣柴扉久不开。","春色满园关不住，","一枝红杏出墙来。"],"textSource":"https://www.guwendao.net/shiwenv_a31b957aba53.aspx","audio":"media/poems/p6b-s07.mp3","lineStarts":[0,2.2927,4.1405,5.9017]},{"id":"p6b-s08","title":"卜算子·送鲍浩然之浙东","author":"王观","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_ee1bd6238d4a.aspx","lines":["水是眼波横，","山是眉峰聚。","欲问行人去那边？","眉眼盈盈处。","才始送春归，","又送君归去。","若到江南赶上春，","千万和春住。"],"textSource":"https://www.guwendao.net/shiwenv_ee1bd6238d4a.aspx","audio":"media/poems/p6b-s08.mp3","lineStarts":[0,1.6342,3.1818,5.01,6.3768,7.791,9.1743,10.981]},{"id":"p6b-s09","title":"浣溪沙·游蕲水清泉寺","author":"苏轼","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_a9a16104dd1b.aspx","lines":["游蕲水清泉寺，寺临兰溪，溪水西流。","山下兰芽短浸溪，","松间沙路净无泥，","萧萧暮雨子规啼。","谁道人生无再少？","门前流水尚能西！","休将白发唱黄鸡。"],"textSource":"https://www.guwendao.net/shiwenv_a9a16104dd1b.aspx","note":"正文开头为苏轼的小序。","audio":"media/poems/p6b-s09.mp3","lineStarts":[0,4.4264,7.0235,9.0138,10.905,12.7603,14.7997]},{"id":"p6b-s10","title":"清平乐·春归何处","author":"黄庭坚","group":"六年级下册(古诗词诵读)","grade":6,"volume":"下","kind":"诗词","url":"https://www.guwendao.net/shiwenv_315cf2d8892b.aspx","lines":["春归何处？","寂寞无行路。","若有人知春去处，","唤取归来同住。","春无踪迹谁知？","除非问取黄鹂。","百啭无人能解，","因风飞过蔷薇。"],"textSource":"https://www.guwendao.net/shiwenv_315cf2d8892b.aspx","note":"正文采用链接页面的主读本，未将异文括注并入朗读。","audio":"media/poems/p6b-s10.mp3","lineStarts":[0,1.3717,2.7465,4.5381,6.1392,8.295,9.9511,11.4373]}]'),d=["小动物","看山水","花草和春天","月亮和星星","刮风和下雪","小朋友玩耍","小船和朋友","大漠和英雄","古代小故事"],p=[{id:"小动物",subtitle:"白鹅 · 蜻蜓 · 小鸡",cover:"art/poems/bg-goose-pond.webp",badgeArt:"art/play/goose.webp"},{id:"看山水",subtitle:"瀑布 · 高山 · 红枫",cover:"art/poems/bg-lushan-waterfall.webp",badgeArt:"art/wordbook/painted/landscape-picture.webp"},{id:"花草和春天",subtitle:"春晓 · 柳树 · 荷花",cover:"art/poems/bg-spring-garden.webp",badgeArt:"art/wordbook/painted/blossom.webp"},{id:"月亮和星星",subtitle:"明月 · 银河 · 渔灯",cover:"art/wordbook/night.webp",badgeArt:"art/play/moon.webp"},{id:"刮风和下雪",subtitle:"大风 · 寒雪 · 梅花",cover:"art/poems/bg-snow-river.webp",badgeArt:"art/wordbook/painted/snowflake.webp"},{id:"小朋友玩耍",subtitle:"采莲 · 钓鱼 · 放风筝",cover:"art/wordbook/meadow.webp",badgeArt:"art/wordbook/child.webp"},{id:"小船和朋友",subtitle:"乘舟 · 送别 · 过节",cover:"art/play/pond.webp",badgeArt:"art/play/boat.webp"},{id:"大漠和英雄",subtitle:"边关 · 骏马 · 豪情",cover:"art/poems/bg-frontier-dusk.webp",badgeArt:"art/wordbook/painted/horse.webp"},{id:"古代小故事",subtitle:"称象 · 砸缸 · 守株",cover:"art/clearing.webp",badgeArt:"art/wordbook/painted/elephant.webp"}],l=Object.fromEntries(p.map(t=>[t.id,t])),u={"goose-pond":"art/poems/bg-goose-pond.webp","lushan-waterfall":"art/poems/bg-lushan-waterfall.webp","spring-garden":"art/poems/bg-spring-garden.webp","snow-river":"art/poems/bg-snow-river.webp","frontier-dusk":"art/poems/bg-frontier-dusk.webp","pond-sunrise":"art/play/pond.webp","autumn-river":"art/wordbook/dawn.webp","starry-night":"art/wordbook/night.webp","storm-plain":"art/wordbook/storm.webp",meadow:"art/wordbook/meadow.webp","clearing-lake":"art/clearing.webp","blossom-canopy":"art/play/canopy.webp","sunny-field":"art/play/orchard.webp"},e=t=>`art/wordbook/painted/${t}.webp`,b={"p1a-j01":{group:"小动物",backdrop:"goose-pond",time:"dawn",atmosphere:"ripples",drama:"yong-e",story:"7岁的骆宾王站在柳树池塘边，看着大白鹅仰头唱歌、红脚掌拨动绿水。",layers:[["art/play/goose.webp",56,56,36,"swim",0,8,0],["art/wordbook/child.webp",20,62,34,"hop",0,2,-2],["art/play/lily.webp",75,67,17,"float",2],[e("music"),61,27,15,"rise",1,3,-6]],verseNotes:["大白鹅游进绿绿的池塘，昂起脖子大声“鹅、鹅、鹅”地叫！","看它弯弯长长的脖子仰向天空，欢快地唱起歌来。","雪白的羽毛轻轻浮在碧绿的水面上，像一朵小白云。","橘红色的鸭掌一左一右拨动清清的波浪，水花闪呀闪！"]},"p1b-j04":{group:"小动物",backdrop:"sunny-field",time:"dawn",atmosphere:"clouds",drama:"hua-ji",archetype:"pastoral-child",cast:["rooster"],story:"雪白的大公鸡顶着红红的鸡冠大步走来，清晨一声叫，千家万户都打开了门。",layers:[[e("chick"),48,57,36,"hop",0,6,0],["art/play/sun.webp",81,22,22,"rise",3,0,-5],[e("house"),22,52,32,"idle",3],[e("music"),57,31,15,"pulse",2]],verseNotes:["不用裁缝做衣裳，它天生戴着鲜红的鸡冠。","一身雪白的羽毛，神气十足地走过来啦。","平时不随便乱说话，静静地守着小院。","早晨一开口啼叫，太阳升起，家家户户都开门醒来啦！"]},"p1b-k05":{group:"小动物",backdrop:"goose-pond",time:"day",atmosphere:"ripples",drama:"xiao-chi",archetype:"spring-blossom",cast:["dragonfly","lotus-bud"],story:"安静的夏初小池塘里，刚冒出尖尖角的小荷叶上，早早停了一只小蜻蜓。",layers:[["art/play/lily.webp",52,61,26,"grow",2],[e("butterfly"),54,41,18,"flutter",3,0,5],[e("water-drop"),27,56,17,"float",0],["art/play/sun.webp",80,21,19,"glow",1]],verseNotes:["细细的泉水舍不得流太快，安静地流出小水花。","树影倒映在池塘里，喜欢晴天里柔和的微风。","嫩绿的小荷叶才刚刚露出尖尖的小角。","早有一只灵巧的小蜻蜓，悄悄落在了荷叶尖上！"]},"p1a-k01":{group:"小动物",backdrop:"pond-sunrise",time:"day",atmosphere:"ripples",story:"满池碧绿的莲叶像撑开的小伞，小红鱼在莲叶东西南北快乐地绕圈做游戏。",layers:[["art/fish.webp",52,56,23,"swim",2,12,-3],["art/play/lily.webp",30,62,22,"float",1],["art/play/lily.webp",72,60,21,"float",1],["art/play/boat.webp",22,43,22,"sail",0]]},"p2a-k04":{group:"小动物",backdrop:"meadow",time:"day",atmosphere:"wind",story:"天高高的、草绿绿的大草原上，风把高高的青草吹弯，露出成群的牛和羊。",layers:[[e("cow"),36,61,28,"idle",6],[e("sheep"),67,63,25,"hop",6],[e("grass"),50,69,21,"sway",5,4,0],[e("cloud"),36,22,18,"drift",0,8,0]]},"p2b-k03":{group:"小动物",backdrop:"spring-garden",time:"day",atmosphere:"clouds",shortHint:"两个黄鹂",story:"两只黄鹂在翠绿柳枝上唱歌，一行白鹭飞上蓝天，窗口望见雪山和远航的大船。",layers:[["art/play/bird.webp",34,41,22,"hop",0],["art/play/bird.webp",64,30,19,"fly",1,10,-8],["art/play/mountain.webp",76,48,25,"idle",2],["art/play/boat.webp",30,67,22,"sail",3]]},"p3b-k01":{group:"小动物",backdrop:"meadow",time:"dawn",atmosphere:"petals",shortHint:"迟日江山丽",story:"春天的太阳暖洋洋，花草香香的，燕子忙着飞来飞去衔泥筑巢，鸳鸯在沙岸边打盹。",layers:[["art/play/bird.webp",35,36,22,"fly",2,12,-4],[e("duck"),63,62,24,"float",3],[e("daisy"),28,67,19,"grow",1],["art/play/sun.webp",78,22,20,"glow",0]]},"p3b-k02":{group:"小动物",backdrop:"goose-pond",time:"dawn",atmosphere:"petals",story:"竹林外桃花开了两三枝，几只小鸭子欢欢喜喜跳进变暖的春江水里游泳。",layers:[[e("duck"),54,60,29,"swim",1,10,0],[e("bamboo"),24,51,37,"sway",0],[e("blossom"),74,36,21,"glow",0],["art/fish.webp",74,68,16,"swim",3,-6,0]]},"p4b-j03":{group:"小动物",backdrop:"spring-garden",time:"day",atmosphere:"petals",story:"不管平地还是高山，小蜜蜂每天从早到晚扑扇翅膀采百花、酿出香甜的花蜜。",layers:[[e("honeybee"),48,43,25,"flutter",2,8,-4],[e("sunflower"),28,62,29,"sway",1],[e("tulip"),71,61,25,"sway",1],[e("honey-jar"),77,68,19,"pulse",3]]},"p5b-j02":{group:"小动物",backdrop:"starry-night",time:"night",atmosphere:"petals",story:"夜深了，春天的山谷安静极了，桂花轻轻飘落，一轮明月升起惊醒了枝头的小山鸟。",layers:[["art/play/moon.webp",74,24,24,"glow",2],["art/play/bird.webp",36,48,22,"fly",2,8,-6],[e("blossom"),54,58,16,"fall",0,2,12],["art/play/mountain.webp",25,59,28,"idle",1]]},"p6b-k04":{group:"小动物",backdrop:"frontier-dusk",time:"night",atmosphere:"wind",story:"银白色的月光照在如雪的大漠沙地上，小骏马昂首扬蹄，准备戴上金笼头驰骋秋夜。",layers:[[e("horse"),52,57,38,"hop",3,10,-2],["art/play/moon.webp",76,22,20,"glow",1],["art/play/mountain.webp",24,50,24,"idle",1]]},"p2a-k02":{group:"看山水",backdrop:"lushan-waterfall",time:"dawn",atmosphere:"mist",drama:"lushan-waterfall",story:"太阳照着庐山香炉峰升起紫色云雾，李白沿着石阶来到山下，仰望飞泻而下的大瀑布，仿佛银河从天上落下来。",layers:[["art/play/sun.webp",22,22,20,"glow",0],["art/wordbook/waterdrop.webp",67,45,32,"fall",1,0,8],["art/wordbook/painted/star.webp",74,19,15,"pulse",3],["art/play/mountain.webp",33,52,28,"idle",0]],verseNotes:["清晨太阳照亮香炉峰，山腰升起袅袅紫烟；李白沿着山路走来。","李白停在青松旁抬头远望：高高的瀑布像一条银带挂在山崖前！","瀑布从高高的悬崖上直冲下来，水花飞溅，水雾滚滚翻腾。","太壮观了！好像天上的星光银河从九重高空直落进大山里！"]},"p1a-j02":{group:"看山水",backdrop:"clearing-lake",time:"day",atmosphere:"none",drama:"hua",story:"走进一幅神奇的山水画：远看青山有颜色，走近却听不见流水声；春天过去了花还在开，人走近小鸟也不害怕。",layers:[[e("landscape-picture"),50,48,42,"pulse",0],["art/play/mountain.webp",30,56,24,"idle",0],[e("blossom"),70,39,19,"grow",2],["art/play/bird.webp",67,57,19,"idle",3]],verseNotes:["远远看去，画卷里连绵的大山青翠又鲜明。","凑近竖起耳朵听一听，画里的小河却安安静静没有水声。","春天已经悄悄走远了，画里的花朵却还开得灿烂。","有人走近画卷拍拍手，枝头的小鸟一点儿也不惊慌——原来是一幅画！"]},"p2a-k01":{group:"看山水",backdrop:"autumn-river",time:"dusk",atmosphere:"clouds",drama:"deng-guan-que-lou",story:"太阳靠着远山慢慢落下，黄河奔向大海；要想看得更远，就鼓起勇气再登上一层高楼！",layers:[["art/play/sun.webp",26,36,23,"fall",0,0,8],["art/play/mountain.webp",25,58,28,"idle",0],[e("wave"),71,61,22,"swim",1,8,0],[e("house"),56,48,28,"rise",3,0,-5]],verseNotes:["金红的落日靠着西边的青山慢慢沉下去。","滚滚的黄河水奔流向前，一直流向遥远的大海。","真想把眼睛望到千里之外，看清更宽广的风景呀。","那就一步一步再登上一层高楼——站得更高，看得更远！"]},"p3a-k05":{group:"看山水",backdrop:"autumn-river",time:"day",atmosphere:"clouds",story:"高大的天门山像被江水劈开，碧绿长江滚滚东流，一只小帆船从太阳升起的天边悠悠驶来。",layers:[["art/play/mountain.webp",26,49,34,"idle",0],["art/play/mountain.webp",74,49,34,"idle",2],["art/play/boat.webp",51,56,25,"sail",3,-6,2],["art/play/sun.webp",54,24,18,"glow",3]]},"p3a-k01":{group:"看山水",backdrop:"pond-sunrise",time:"night",atmosphere:"stars",story:"秋夜的月光像镜面洒在平静的洞庭湖上，湖心的小翠山看起来就像白银盘里托着一颗小青螺。",layers:[["art/play/moon.webp",68,23,24,"glow",0],["art/play/mountain.webp",50,56,24,"idle",2],["art/play/plate.webp",50,68,22,"float",3]]},"p3a-k06":{group:"看山水",backdrop:"goose-pond",time:"mist",atmosphere:"rain",story:"晴天阳光下的西湖水光波光粼粼真好看，下雨天雾蒙蒙的青山也像仙境一样美！",layers:[["art/play/sun.webp",27,23,20,"glow",0],[e("rain-cloud"),71,22,20,"drift",1],["art/play/boat.webp",50,60,26,"sail",0]]},"p3a-k02":{group:"看山水",backdrop:"autumn-river",time:"dusk",atmosphere:"leaves",story:"沿着弯曲的石径走上秋天的寒山，停下来看深红的枫叶——被秋霜染红的枫林比二月春花还要红艳！",layers:[[e("maple-leaf"),34,39,24,"drift",3,6,8],[e("maple-leaf"),64,47,21,"drift",2,-5,7],["art/play/tree.webp",25,56,35,"sway",2],[e("house"),72,46,22,"idle",1]]},"p3a-k04":{group:"看山水",backdrop:"blossom-canopy",time:"dusk",atmosphere:"leaves",story:"安静的空山里看不见人影，只听见远处传来说话声，夕阳余晖照进深林，落在绿绿的青苔上。",layers:[["art/play/tree.webp",26,52,39,"sway",0],[e("deer"),62,60,27,"idle",1],["art/play/sun.webp",75,24,19,"glow",2],[e("grass"),50,72,19,"grow",3]]},"p3b-k03":{group:"看山水",backdrop:"blossom-canopy",time:"day",atmosphere:"clouds",story:"梅子黄澄澄的晴朗天，坐完小船又走上翠绿山路，浓浓的树荫下传来四五声清脆的黄鹂鸣唱。",layers:[["art/play/boat.webp",27,62,23,"sail",1],["art/play/bird.webp",67,36,22,"fly",3,6,-4],["art/play/tree.webp",52,54,34,"sway",2],["art/play/sun.webp",80,21,18,"glow",0]]},"p4a-k02":{group:"看山水",backdrop:"lushan-waterfall",time:"mist",atmosphere:"mist",story:"横看庐山是一道山岭，侧看是一座尖峰，站在山里面总是只看到眼前一角，跳出来才能看清整座庐山。",layers:[["art/play/mountain.webp",33,52,33,"idle",0],["art/play/mountain.webp",68,54,29,"idle",1],[e("cloud"),52,30,20,"drift",2,10,0]]},"p4b-j04":{group:"看山水",backdrop:"clearing-lake",time:"day",atmosphere:"clouds",story:"成群的飞鸟向高空飞去，连最后一朵白云也悠闲飘走，只有诗人和安静的敬亭山彼此看着看不够。",layers:[["art/play/mountain.webp",54,54,34,"idle",3],["art/play/bird.webp",26,28,17,"fly",0,14,-10],[e("cloud"),72,25,20,"drift",1,12,0]]},"p5a-k05":{group:"看山水",backdrop:"starry-night",time:"night",atmosphere:"ripples",story:"一场新雨过后秋山特别清爽，明月穿过松林照亮石头上的清泉，洗衣姑娘笑着回家，莲叶晃动让出渔船。",layers:[["art/play/moon.webp",52,23,22,"glow",2],[e("water-drop"),30,58,19,"fall",3],[e("bamboo"),76,52,35,"sway",4],["art/play/boat.webp",64,67,21,"sail",5]]},"p6a-k07":{group:"看山水",backdrop:"spring-garden",time:"day",atmosphere:"petals",story:"院子打扫得干干净净没有青苔，小河绕着农田流淌，推开木门就能看见两座青翠的大山把绿意送进屋里。",layers:[[e("house"),32,54,33,"idle",0],["art/play/mountain.webp",70,50,32,"idle",3],[e("blossom"),54,62,18,"grow",1]]},"p6b-k05":{group:"看山水",backdrop:"storm-plain",time:"mist",atmosphere:"sparks",story:"经历千锤百炼走出深山、不怕烈火考验的石灰石，一心只想把清清白白留在人间。",layers:[[e("stone"),46,61,31,"idle",0],["art/wordbook/fire.webp",64,55,31,"pulse",1],["art/play/mountain.webp",26,49,28,"idle",0]]},"p6b-k06":{group:"看山水",backdrop:"lushan-waterfall",time:"mist",atmosphere:"wind",story:"翠竹把根深深扎进青山岩石缝里，不管东西南北哪边吹来狂风，它都笔直又坚定地站立着。",layers:[[e("bamboo"),52,50,44,"sway",3],[e("stone"),52,69,22,"idle",1],["art/play/mountain.webp",24,53,28,"idle",0]]},"p1b-j01":{group:"花草和春天",backdrop:"spring-garden",time:"dawn",atmosphere:"petals",drama:"chun-xiao",story:"春天的早晨睡得可香啦，窗外到处都是小鸟吱吱喳喳的叫声；昨晚刮风又下雨，不知道花园里落了多少花瓣呢。",layers:[[e("window"),49,44,39,"idle",0],["art/play/bird.webp",66,36,20,"hop",1],[e("blossom"),33,56,20,"fall",3,4,12],[e("blossom"),67,63,18,"fall",3,-4,10]],verseNotes:["春天睡得暖融融、甜滋滋，不知不觉天已经亮啦！","竖起耳朵听，窗外枝头到处都是小鸟清脆的欢叫声。","昨晚还沙沙下过一阵春夜的风和春雨呢。","推开窗看一看，院子里轻轻落下了多少粉红花瓣呀？"]},"p2b-k01":{group:"花草和春天",backdrop:"spring-garden",time:"day",atmosphere:"wind",story:"高高的柳树像用碧玉打扮过，千万条绿丝带垂在春风里，原来是二月细细的春风小剪刀裁出这么嫩的柳叶。",layers:[["art/play/tree.webp",49,51,44,"sway",0],[e("green-leaf"),34,44,19,"drift",2],[e("green-leaf"),66,48,19,"drift",3]]},"p2b-k04":{group:"花草和春天",backdrop:"goose-pond",time:"day",atmosphere:"petals",story:"六月的西湖实在太美啦，绿得望不到边的荷叶一直连到天边，阳光照在粉红荷花上格外鲜艳。",layers:[["art/play/lily.webp",33,62,23,"float",2],["art/play/lily.webp",67,61,24,"float",2],[e("blossom"),50,54,24,"grow",3],["art/play/sun.webp",78,22,20,"glow",3]]},"p2b-j01":{group:"花草和春天",backdrop:"meadow",time:"day",atmosphere:"wind",story:"草原上的青草每年秋天变黄、冬天藏进泥土，可只要春风轻轻一吹，嫩芽立刻又冒出绿油油的一片！",layers:[[e("grass"),34,62,28,"grow",3],[e("grass"),66,62,28,"grow",3],[e("seedling"),50,65,24,"grow",3],["art/wordbook/fire.webp",74,48,20,"pulse",2]]},"p3b-j01":{group:"花草和春天",backdrop:"pond-sunrise",time:"dawn",atmosphere:"petals",story:"太阳升起的时候，江边的红花比火还要红艳；春天一来，清清的江水绿得像一块发光的蓝绿宝石。",layers:[["art/play/sun.webp",72,24,23,"glow",2],[e("blossom"),31,56,23,"grow",2],["art/play/boat.webp",56,60,23,"sail",3]]},"p3b-j03":{group:"花草和春天",backdrop:"lushan-waterfall",time:"day",atmosphere:"petals",story:"山脚下的春花都快谢完啦，走进山顶的小寺庙，却惊喜发现满树桃花刚刚开得热热闹闹！",layers:[[e("blossom"),36,44,25,"grow",1],[e("blossom"),64,40,23,"grow",1],[e("house"),56,56,26,"idle",1],["art/play/mountain.webp",26,57,27,"idle",0]]},"p4a-j01":{group:"花草和春天",backdrop:"autumn-river",time:"dusk",atmosphere:"leaves",story:"秋天池塘荷叶虽已枯尽，菊花却还骄傲地顶着寒霜开放；记好啦，黄橙和青橘成熟的时候才是一年最美的好光景！",layers:[[e("orange"),37,56,25,"glow",3],[e("daisy"),63,59,25,"sway",1],[e("maple-leaf"),74,34,18,"fall",0,-4,10]]},"p4b-k01":{group:"花草和春天",backdrop:"sunny-field",time:"day",atmosphere:"petals",story:"初夏乡村太阳长长的，金黄梅子和肥大杏子挂满枝头，雪白的麦花旁边只有黄蝴蝶和蜻蜓飞来飞去。",layers:[[e("butterfly"),38,41,22,"flutter",3,10,-4],[e("butterfly"),65,48,20,"flutter",3,-8,3],[e("rice-stalks"),30,62,26,"sway",1],[e("peach"),72,57,21,"glow",0]]},"p4b-j02":{group:"花草和春天",backdrop:"spring-garden",time:"day",atmosphere:"petals",shortHint:"江畔独步寻花",story:"暖洋洋的春风里，江边一丛桃花开得满树粉红又娇嫩，深红的和浅粉的花朵真不知道该先喜欢哪一朵。",layers:[[e("blossom"),36,46,28,"grow",2],[e("blossom"),59,43,30,"grow",3],[e("butterfly"),73,36,17,"flutter",1]]},"p6a-j01":{group:"花草和春天",backdrop:"blossom-canopy",time:"day",atmosphere:"petals",shortHint:"其五·桃花",story:"黄师塔前的江水向东流去，微风里那一整簇无主的桃花深红浅红交织，美得让人舍不得走开。",layers:[[e("blossom"),45,45,29,"grow",2],[e("blossom"),65,51,26,"grow",3],[e("honeybee"),31,41,18,"flutter",1]]},"p5a-k07":{group:"花草和春天",backdrop:"spring-garden",time:"mist",atmosphere:"rain",shortHint:"早春·天街小雨",story:"早春下着像酥油一样柔润的细雨，远远看去草地好像铺了淡淡的新绿，走近一看小草才刚刚冒芽。",layers:[[e("rain-cloud"),48,23,22,"drift",0],[e("seedling"),35,65,23,"grow",1],[e("seedling"),63,66,22,"grow",1],[e("water-drop"),48,44,15,"fall",0,0,10]]},"p6b-s04":{group:"花草和春天",backdrop:"meadow",time:"mist",atmosphere:"rain",shortHint:"草色遥看近却无",story:"初春细雨滋润大地，远远望见一层浅浅嫩绿的草芽，这正是春天最让人欣喜的小时候。",layers:[[e("seedling"),49,63,26,"grow",1],[e("rain-cloud"),62,23,21,"drift",0],[e("grass"),30,66,22,"grow",1]]},"p6a-k06":{group:"花草和春天",backdrop:"pond-sunrise",time:"mist",atmosphere:"rain",story:"千里江南黄莺啼叫、绿树映着红花，水村山城酒旗在春风里飘扬，远处的楼台掩映在细细春雨里。",layers:[["art/play/bird.webp",29,34,20,"fly",0],[e("house"),66,51,28,"idle",2],[e("blossom"),45,56,19,"glow",0],[e("rain-cloud"),52,21,20,"drift",3]]},"p6b-s03":{group:"花草和春天",backdrop:"starry-night",time:"night",atmosphere:"rain",story:"懂事的好春雨挑了安静的夜晚随着微风悄悄飘落，第二天清晨，全城的花朵都湿润饱满、开得鲜红沉甸。",layers:[[e("rain-cloud"),52,22,22,"drift",1],["art/play/boat.webp",70,62,21,"sail",2],[e("lamp"),69,53,14,"glow",2],[e("blossom"),34,59,25,"grow",3]]},"p6b-s07":{group:"花草和春天",backdrop:"spring-garden",time:"day",atmosphere:"petals",story:"轻轻敲半天柴门没人在家，可满园子的春色哪关得住呀，一枝红艳艳的杏花早伸出院墙外冲着人笑呢！",layers:[[e("door"),36,56,32,"idle",1],[e("blossom"),64,39,30,"grow",3,6,-4],[e("grass"),35,70,17,"idle",0]]},"p6b-s09":{group:"花草和春天",backdrop:"blossom-canopy",time:"mist",atmosphere:"rain",story:"松林间的沙路被雨水冲得干净无泥，山下兰芽浸在向西流的小溪里，连白头发爷爷也像少年一样精神爽朗！",layers:[[e("seedling"),35,62,23,"grow",1],["art/play/bird.webp",67,36,20,"hop",3],[e("water-drop"),52,57,17,"swim",4,-8,0]]},"p6b-s10":{group:"花草和春天",backdrop:"spring-garden",time:"day",atmosphere:"petals",story:"春天跑去哪里了呢？问一问枝头叽叽喳喳唱了上百遍的黄鹂，原来春天乘着春风飞过蔷薇花架啦。",layers:[["art/play/bird.webp",49,41,24,"fly",3,12,-5],[e("tulip"),30,60,25,"sway",3],[e("blossom"),72,53,25,"sway",3]]},"p6b-j01":{group:"花草和春天",backdrop:"sunny-field",time:"dawn",atmosphere:"clouds",story:"园子里的向日葵等着朝阳晒干露水，百川向东流去不回头；趁着年少有朝气，要好好加油长大呀！",layers:[[e("sunflower"),48,56,36,"grow",0],["art/play/sun.webp",76,22,23,"rise",1,0,-5],[e("water-drop"),40,48,14,"glow",0]]},"p5a-j04":{group:"花草和春天",backdrop:"goose-pond",time:"day",atmosphere:"clouds",story:"方方的小池塘像一面亮晶晶的镜子映出蓝天白云，为什么池水这么清澈？因为有源源不断的活水天天流进来！",layers:[[e("mirror"),48,53,29,"glow",0],[e("cloud"),62,23,21,"drift",1,8,0],[e("water-drop"),28,57,20,"swim",3,8,0]]},"p1b-k01":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",drama:"jing-ye-si",story:"夜晚安静极了，一轮明亮的白月亮透过木窗把银光洒在床前，诗人抬头望向圆月，低头想念远方的家。",layers:[["art/play/moon.webp",73,23,23,"glow",0],[e("window"),62,39,32,"idle",0],[e("bed"),28,63,33,"idle",0],["art/wordbook/painted/star.webp",45,22,13,"pulse",2]],verseNotes:["清亮的月光透过窗子，轻轻洒在小小的木床前面。","白白的月光照在地上，好像下了一层薄薄的银色秋霜！","诗人抬起头，静静望着天上圆又亮的明月。","他轻轻低下头，想起了远方温暖的家乡和亲人。"]},"p1a-j04":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",drama:"gu-lang-yue-xing",story:"小时候李白不认识月亮，把它叫作白玉大圆盘，又猜它是神仙的白玉镜子，高高飞在青青云端里。",layers:[["art/play/moon.webp",56,29,28,"rise",3,0,-5],["art/play/plate.webp",29,34,21,"pulse",1],[e("mirror"),76,36,20,"pulse",2],["art/wordbook/child.webp",30,68,30,"idle",0]],verseNotes:["小李白抬头看着天上发光的圆东西，还不知道它叫月亮呢。","圆圆白白的，叫它一个亮晶晶的“白玉大圆盘”吧！","再多看一眼，它又像仙女梳妆台上的白玉明镜。","亮晶晶的明镜轻轻飞上高高的青云端啦！"]},"p2a-j03":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",story:"住在高高山顶小寺庙的百尺高楼上，伸一伸手好像就能摘到亮闪闪的星星，都不敢大声说话呢！",layers:[[e("star"),36,23,20,"pulse",1],[e("star"),62,20,22,"pulse",1],[e("star"),76,33,17,"pulse",1],[e("house"),38,61,33,"idle",0]]},"p3a-j02":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"ripples",story:"没有月亮的黑夜里，江面上只有渔船一盏小小的灯火像萤火虫，微风一吹水波荡开，一盏灯碎成满河小星星！",layers:[["art/play/boat.webp",49,57,27,"sail",0],[e("lamp"),51,47,17,"glow",1],[e("star"),28,67,14,"pulse",3],[e("star"),72,66,14,"pulse",3]]},"p4a-k01":{group:"月亮和星星",backdrop:"autumn-river",time:"dusk",atmosphere:"stars",story:"傍晚夕阳照在江水上一半碧绿一半火红；到夜晚九月初三，草叶露水像圆珍珠，弯弯的月亮像一把小银弓。",layers:[["art/play/sun.webp",26,34,22,"fall",0,0,6],["art/wordbook/moon.webp",74,24,23,"glow",3],[e("water-drop"),48,67,17,"glow",3]]},"p4a-j02":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",story:"深夜里烛影长长，银河慢慢西沉，星星渐渐淡去，碧海青天之间，广寒宫里只见一轮静静的明月。",layers:[["art/play/moon.webp",67,25,25,"glow",3],[e("lamp"),29,59,24,"glow",0],[e("star"),45,22,16,"pulse",1]]},"p5a-k06":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"leaves",story:"月亮西落、乌鸦轻啼的深秋寒夜，小船停在枫树桥边对着一盏渔火，远处寒山寺半夜传来悠悠钟声。",layers:[["art/play/boat.webp",48,61,27,"sail",1],[e("bell"),76,31,22,"sway",3],[e("maple-leaf"),26,44,21,"fall",1],[e("lamp"),51,51,15,"glow",1]]},"p5a-j01":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",story:"七夕夏夜仰望深蓝星空，牛郎星和织女星正在鹊桥相会，家家小院仰望秋月，小姑娘们比谁穿针线最灵巧！",layers:[[e("bridge"),50,44,26,"glow",1],[e("star"),30,24,18,"pulse",1],[e("star"),70,24,18,"pulse",1],["art/play/moon.webp",50,20,17,"glow",2]]},"p6a-k01":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"mist",story:"把小船停在起着轻雾的小洲旁，旷野辽阔得好像天空压在低矮的树梢上，清清的江水倒映着月亮离人好近。",layers:[["art/play/boat.webp",44,62,26,"sail",0],["art/play/moon.webp",70,26,22,"glow",3],["art/play/tree.webp",22,54,32,"idle",2]]},"p6a-k03":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"fireflies",story:"明月照亮枝头惊飞了喜鹊，夜风送来稻花香和池塘一片蛙声；天外闪烁几颗星，绕过小溪石桥突然看见老茅店！",layers:[["art/play/moon.webp",26,22,22,"glow",0],[e("frog"),67,67,21,"hop",3],[e("star"),69,20,16,"pulse",4],[e("bridge"),46,61,24,"idle",7]]},"p6b-k02":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",story:"高高的天河两岸，亮晶晶的织女星与牵牛星隔着清浅的银河相望，默默彼此牵挂。",layers:[[e("star"),28,28,22,"pulse",0],[e("star"),73,28,22,"pulse",0],[e("yarn"),50,56,23,"sway",3]]},"p6b-k03":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"stars",story:"中秋月光把小院照得雪白，乌鸦悄悄歇在树梢，清凉秋露沾湿院里的桂花；今晚人人都在抬头看同一轮明月。",layers:[["art/play/moon.webp",52,22,26,"glow",2],["art/play/bird.webp",27,45,19,"idle",0],[e("blossom"),72,55,22,"glow",1]]},"p1a-j05":{group:"刮风和下雪",backdrop:"clearing-lake",time:"day",atmosphere:"wind",drama:"feng",story:"看不见摸不着的风其实力气可大了：吹落秋天树叶，吹开二月春花，吹起大江千尺波浪，吹弯万竿翠竹！",layers:[["art/wordbook/windtree.webp",33,52,39,"sway",0],[e("maple-leaf"),68,46,21,"fall",0,10,10],[e("blossom"),64,59,21,"grow",1],[e("bamboo"),73,51,36,"sway",3]],verseNotes:["呼——秋风吹过树梢，金红的树叶一片片飘落下来！","暖暖的春风轻轻拂过枝头，二月的小花全都笑开了花。","大风吹过大江水面，激起雪白翻涌的千尺浪花！","阵阵大风钻进翠绿的竹林里，整片竹竿齐刷刷地斜弯下去！"]},"p2a-k03":{group:"刮风和下雪",backdrop:"snow-river",time:"snow",atmosphere:"snow",drama:"jiang-xue",story:"大雪下个不停，千座山头没有鸟飞，万条小路不见人影，只有一位戴斗笠穿蓑衣的老爷爷坐在小船里独自钓鱼。",layers:[["art/play/boat.webp",52,62,29,"sail",2],[e("snowflake"),30,26,17,"fall",0,2,14],[e("snowflake"),72,32,16,"fall",0,-2,14],["art/fish.webp",49,75,14,"swim",3,6,0]],verseNotes:["大雪纷飞，千座连绵的高山上飞鸟都看不见一只。","白雪盖住了万条山间小路，一点儿脚印也没有。","冰冷的大江中央，一叶孤单的小船上坐着戴斗笠的渔翁。","雪花还在静静飘落，老渔翁依然稳稳拿着鱼竿独钓寒江！"]},"p2a-j01":{group:"刮风和下雪",backdrop:"snow-river",time:"snow",atmosphere:"snow",drama:"mei-hua",archetype:"winter-plum",cast:["plum"],story:"墙角边几枝红梅一点也不怕冷，在大雪里独自开放；老远就知道那不是雪花，因为阵阵幽香飘过来了！",layers:[[e("blossom"),44,44,28,"grow",1],[e("blossom"),61,52,23,"grow",1],[e("snowflake"),32,26,17,"fall",2,2,10],[e("snowflake"),74,30,16,"fall",2,-2,10]],verseNotes:["墙角边静静探出几枝梅花枝，挺立在冬日院墙旁。","满天寒风大雪里，梅花一点也不怕冷，独自热烈地开放。","远远望过去洁白得像雪一样，可我知道它不是雪花——","一阵阵清幽的暗香正随风飘过来，一眼就知道是凌寒的梅花！"]},"p4a-k03":{group:"刮风和下雪",backdrop:"snow-river",time:"snow",atmosphere:"snow",story:"梅花和雪花比赛谁更能代表春天，诗人想半天也没分出胜负：梅花没雪那么洁白，可雪花却少了一段清香呀！",layers:[[e("blossom"),36,51,29,"glow",2],[e("snowflake"),66,48,28,"pulse",2]]},"p4b-k06":{group:"刮风和下雪",backdrop:"clearing-lake",time:"mist",atmosphere:"petals",story:"画家洗砚池边一棵老梅树，开出的花朵只沾着淡淡墨痕，不爱炫耀鲜艳颜色，只愿清香飘满天地。",layers:[[e("paintbrush"),33,56,28,"sway",1],[e("blossom"),63,45,29,"glow",1]]},"p6a-k02":{group:"刮风和下雪",backdrop:"storm-plain",time:"mist",atmosphere:"rain",story:"乌云像打翻了黑墨水滚过山头，白花花的大雨点像珍珠一样跳进船里；忽然一阵大风把乌云吹散，湖面又和蓝天一样清亮！",layers:[[e("rain-cloud"),48,25,27,"drift",0,12,0],[e("water-drop"),38,48,17,"fall",1,0,12],["art/play/boat.webp",56,63,25,"sail",1],["art/play/sun.webp",78,22,19,"glow",3]]},"p6b-s01":{group:"刮风和下雪",backdrop:"snow-river",time:"snow",atmosphere:"snow",story:"当年离家时春天的杨柳随风摇摆，如今归来的路上大雪漫天飘飞，走得好慢好辛苦呀。",layers:[["art/play/tree.webp",27,52,34,"sway",0],[e("snowflake"),64,30,19,"fall",2,0,14],[e("footprints"),53,69,20,"idle",4]]},"p5a-j03":{group:"刮风和下雪",backdrop:"spring-garden",time:"mist",atmosphere:"rain",story:"西塞山前白鹭振翅飞翔，江里桃花流水、肥美的鳜鱼游来游去，穿戴青竹笠和绿蓑衣的老翁在细雨斜风中悠闲垂钓不愿回家。",layers:[["art/play/bird.webp",67,29,20,"fly",0,10,-4],["art/fish.webp",36,66,21,"swim",1,8,0],["art/play/boat.webp",56,58,24,"sail",3],[e("blossom"),27,41,18,"fall",1]]},"p3b-j02":{group:"刮风和下雪",backdrop:"storm-plain",time:"mist",atmosphere:"rain",story:"寂静小河边长着绿青草，深树里有黄鹂清啼；傍晚急雨带着春潮涌来，空荡的渡口边小船自己横停在水面上。",layers:[["art/play/boat.webp",53,62,26,"sail",3],["art/play/bird.webp",30,35,19,"hop",1],[e("rain-cloud"),65,22,20,"drift",2]]},"p1b-k04":{group:"小朋友玩耍",backdrop:"goose-pond",time:"day",atmosphere:"ripples",drama:"chi-shang",story:"一个小娃娃悄悄划着小木船进池塘采大白莲，以为没人知道，可船后面劈开一道长长的绿浮萍露出小秘密！",layers:[["art/play/boat.webp",52,57,29,"sail",0,14,0],["art/wordbook/child.webp",49,43,25,"hop",0,14,0],["art/play/lily.webp",75,62,20,"float",1],[e("blossom"),74,52,16,"glow",1]],verseNotes:["小娃娃撑着竹竿，悄悄划着小木船驶进池塘深处。","伸出小手采到了又白又香的莲蓬，高兴地往回划！","小娃娃还以为自己偷偷出来谁也不会发现呢。","嘻嘻，小船后面划开一道长长的绿色浮萍水路，露馅啦！"]},"p2b-k02":{group:"小朋友玩耍",backdrop:"meadow",time:"day",atmosphere:"wind",drama:"cun-ju",story:"二月青草长高、黄莺飞舞、杨柳飘拂春烟；小朋友放学早早跑回草坪，乘着东风一起放高高的纸风筝！",layers:[["art/wordbook/child.webp",34,63,33,"hop",2,10,-2],[e("runner"),54,65,31,"hop",2,10,-3],["art/play/bird.webp",26,30,18,"fly",0,10,-4],[e("balloon"),74,24,22,"rise",3,6,-8]],verseNotes:["春天来了！二月青草长高，黄莺在天空快乐地飞舞。","河堤上的嫩绿柳丝轻轻摆动，仿佛醉在软软春烟里。","村里的小朋友早早放学回家，三五成群跑向大草地。","拉起长长的风筝线趁着东风奔跑——风筝高高飞上天啦！"]},"p2a-j02":{group:"小朋友玩耍",backdrop:"pond-sunrise",time:"day",atmosphere:"ripples",story:"头发乱蓬蓬的小娃娃侧坐在青苔草丛边专心学钓鱼，有人来问路赶紧摆摆小手——嘘，小声点，别吓跑小鱼！",layers:[["art/wordbook/child.webp",35,61,31,"idle",0],["art/fish.webp",69,69,17,"swim",3,-6,0],[e("grass"),24,67,21,"sway",1]]},"p3a-j01":{group:"小朋友玩耍",backdrop:"meadow",time:"day",atmosphere:"clouds",story:"小牧童骑在黄牛背上响亮地唱山歌，歌声传遍树林；忽然看见树上有一只叫个不停的蝉，马上闭住嘴屏住呼吸站住啦！",layers:[[e("cow"),52,60,32,"idle",0],["art/wordbook/child.webp",49,44,25,"idle",2],["art/play/tree.webp",75,48,36,"idle",1],[e("music"),31,30,15,"pulse",1]]},"p3a-j04":{group:"小朋友玩耍",backdrop:"goose-pond",time:"day",atmosphere:"ripples",story:"穿绿色罗裙的姑娘采莲走进碧绿荷塘，裙摆和荷叶混成一片，直到听见歌声才知道荷花丛里有人来过。",layers:[[e("dancer"),48,56,33,"sway",0],["art/play/lily.webp",30,65,22,"float",2],["art/play/lily.webp",72,63,21,"float",2],[e("music"),65,29,16,"rise",3]]},"p3a-k03":{group:"月亮和星星",backdrop:"starry-night",time:"night",atmosphere:"fireflies",story:"秋天夜晚梧桐叶沙沙作响，诗人忽然看见远处篱笆角落一盏明亮小灯——原来有小朋友半夜还在拿小棍逗蟋蟀呢！",layers:[[e("lamp"),67,56,24,"glow",3],["art/wordbook/child.webp",52,62,28,"idle",2],[e("dry-leaves"),28,39,19,"fall",0,4,12]]},"p4b-k02":{group:"小朋友玩耍",backdrop:"sunny-field",time:"day",atmosphere:"petals",story:"春天新绿才刚冒头还没成阴凉，小朋友一路小跑追着一只亮黄色的蝴蝶，扑通一下，蝴蝶飞进黄灿灿的油菜花里找不着啦！",layers:[[e("runner"),35,62,32,"hop",2,12,-2],[e("butterfly"),66,46,22,"flutter",2,12,-6],[e("daisy"),73,63,24,"sway",3]]},"p4b-k03":{group:"小朋友玩耍",backdrop:"clearing-lake",time:"day",atmosphere:"clouds",story:"矮矮的茅屋门口青草绿绿，大哥哥在溪东锄豆苗，二哥哥编织鸡笼，最可爱的小弟弟趴在溪边偷剥莲蓬吃！",layers:[[e("house"),26,49,30,"idle",0],["art/wordbook/child.webp",67,63,29,"hop",6],["art/play/lily.webp",52,67,19,"float",7]]},"p5b-k01":{group:"小朋友玩耍",backdrop:"sunny-field",time:"day",atmosphere:"clouds",story:"村里大人们忙着种田纺麻，还没学会耕地的小娃娃也不闲着，蹲在阴凉的大桑树下面认真地学着种小西瓜！",layers:[["art/wordbook/child.webp",39,62,31,"hop",2],[e("watermelon"),64,65,22,"grow",3],["art/play/tree.webp",72,46,36,"sway",2]]},"p5b-k02":{group:"小朋友玩耍",backdrop:"snow-river",time:"snow",atmosphere:"snow",story:"冬天大早小娃娃从铜盆里脱出一块亮圆冰，用彩线穿起来当小铜锣敲，当当声穿透树林，啪嚓一下碎在地上像玻璃！",layers:[[e("ice-cube"),52,52,26,"pulse",1],["art/wordbook/child.webp",31,61,32,"hop",0],[e("snowflake"),72,28,17,"fall",0]]},"p5b-k03":{group:"小朋友玩耍",backdrop:"autumn-river",time:"dusk",atmosphere:"ripples",story:"青草长满水边、落日衔在山头，小牧童天黑回家干脆横躺在老黄牛背上，拿着小短笛随心所欲呜哩哇啦地吹着玩。",layers:[[e("cow"),52,62,31,"glide",2,-8,0],["art/wordbook/child.webp",52,46,24,"sway",2,-8,0],["art/play/sun.webp",24,38,22,"fall",1],[e("music"),68,33,16,"rise",3]]},"p1a-j03":{group:"小朋友玩耍",backdrop:"sunny-field",time:"day",atmosphere:"none",drama:"min-nong",story:"大中午太阳正火辣辣晒着，农民伯伯弯腰给禾苗松土，汗水一滴一滴落进土里；碗里的每一颗白米饭都来之不易呀！",layers:[["art/play/sun.webp",52,20,22,"glow",0],[e("rice-stalks"),32,60,28,"sway",1],[e("water-drop"),44,52,13,"fall",1,0,12],[e("rice-bowl"),71,62,26,"pulse",2]],verseNotes:["正午火辣辣的太阳高挂天上，田里的庄稼正需要照料。","一滴又一滴晶莹的汗水，顺着脸颊落进禾苗下的泥土里。","低头看一看桌子上那碗白花花、香喷喷的米饭呀。","每一粒米饭背后，都有农民伯伯流下的汗水与辛苦呢！"]},"p2b-j02":{group:"小朋友玩耍",backdrop:"sunny-field",time:"dusk",atmosphere:"leaves",story:"春天种下一颗小小的谷子，秋天能收获千万粒粮食，可惜古时候农民辛苦一年还是吃不饱，更让人懂得珍惜每一粒粮。",layers:[["art/play/seed.webp",31,60,22,"hop",0],[e("rice-stalks"),62,56,33,"grow",1]]},"p5b-j05":{group:"小朋友玩耍",backdrop:"spring-garden",time:"mist",atmosphere:"rain",story:"四月的乡村绿遍山野、满河白水泛亮，细雨像白烟飘过，村里人刚刚收完蚕桑又忙着下田插秧。",layers:[[e("rice-stalks"),38,62,28,"grow",3],[e("seedling"),63,63,24,"grow",3],["art/play/bird.webp",72,32,18,"fly",1]]},"p6a-j04":{group:"小朋友玩耍",backdrop:"clearing-lake",time:"day",atmosphere:"clouds",story:"老朋友准备好香喷喷的饭菜邀请诗人到农家做客，推开窗就是农田果园，相约重阳节再来赏满园菊花！",layers:[[e("house"),32,53,33,"idle",1],[e("daisy"),67,61,24,"grow",3],[e("tea-cup"),52,65,18,"idle",2]]},"p1b-j03":{group:"小船和朋友",backdrop:"pond-sunrise",time:"day",atmosphere:"petals",story:"李白刚登上小船准备远行，岸边忽然响起拍手踏脚唱歌的声音——好朋友汪伦一路唱着歌来送别他，情谊比桃花潭还深！",layers:[["art/play/boat.webp",56,58,30,"sail",0,8,0],[e("blossom"),26,48,22,"fall",2,4,12],[e("music"),28,30,17,"rise",1]]},"p3a-j03":{group:"小船和朋友",backdrop:"pond-sunrise",time:"dawn",atmosphere:"clouds",drama:"zao-fa-bai-di-cheng",archetype:"water-voyage",cast:["skiff","poet"],story:"早晨告别彩霞里的白帝城，两边的猿猴还在山崖叫不停呢，轻快的小木船早已嗖嗖穿过重重青山驶出老远！",layers:[["art/play/boat.webp",50,58,29,"sail",3,18,0],["art/play/mountain.webp",25,48,30,"idle",2],["art/play/mountain.webp",76,48,30,"idle",2],[e("cloud"),36,22,18,"drift",0]],verseNotes:["早晨告别满天绚丽彩霞里的白帝城，轻舟启程啦。","千里远的江陵路途，顺流而下一天就能快速到达！","江岸两旁高崖上的猿猴还在不停地鸣叫，声音回荡在山谷。","轻快的小木船早已乘风破浪，穿过一重又一重青山飞驰而出！"]},"p5b-j04":{group:"小船和朋友",backdrop:"pond-sunrise",time:"day",atmosphere:"petals",story:"三月春暖花开时节，李白站在黄鹤楼挥手送别孟浩然坐船去扬州，白帆越来越远消失在天边，只见滚滚长江水向东奔流。",layers:[["art/play/boat.webp",64,54,24,"sail",2,14,-4],[e("house"),25,49,31,"idle",0],[e("blossom"),44,34,17,"fall",1]]},"p4a-j03":{group:"小船和朋友",backdrop:"snow-river",time:"snow",atmosphere:"snow",story:"北风吹着大雁大雪纷纷，不要为前面的路发愁没有好朋友，天下有谁不认识优秀的你呢！",layers:[["art/play/bird.webp",48,31,22,"fly",1,14,-4],[e("snowflake"),28,34,17,"fall",1],[e("snowflake"),72,40,16,"fall",1],[e("cloud"),32,22,19,"drift",0]]},"p4b-k04":{group:"小船和朋友",backdrop:"pond-sunrise",time:"mist",atmosphere:"rain",story:"夜雨后天刚亮在江边送走朋友，若家乡亲友问起我过得怎样，就说我的心像装在玉壶里的一块晶莹透明冰！",layers:[[e("ice-cube"),50,52,26,"glow",3],["art/play/mountain.webp",73,53,28,"idle",1],[e("rain-cloud"),29,23,20,"drift",0]]},"p6a-j03":{group:"小船和朋友",backdrop:"spring-garden",time:"mist",atmosphere:"rain",shortHint:"送元二使安西",story:"早晨微雨把路面灰尘洗净，客栈旁边的青柳树显得清新翠绿，再干了这杯茶水，向西去可就难遇见老熟人啦。",layers:[[e("tea-cup"),50,61,24,"pulse",2],["art/play/tree.webp",26,48,35,"sway",1],[e("rain-cloud"),68,22,20,"drift",0]]},"p6b-s02":{group:"小船和朋友",backdrop:"spring-garden",time:"mist",atmosphere:"rain",shortHint:"渭城朝雨",story:"渭城的晨雨润湿春柳，举杯惜别即将西行远游的老朋友。",layers:[[e("tea-cup"),52,60,24,"pulse",2],["art/play/tree.webp",73,49,34,"sway",1]]},"p6b-s06":{group:"小船和朋友",backdrop:"pond-sunrise",time:"night",atmosphere:"wind",story:"小船停靠在瓜洲渡口，只隔一条江水就快看见故乡钟山了；春风再次吹绿江南岸，什么时候明月才照着我回家呢？",layers:[["art/play/boat.webp",50,62,28,"sail",0],["art/play/moon.webp",75,22,22,"glow",3],[e("green-leaf"),29,54,19,"grow",2]]},"p6b-s08":{group:"小船和朋友",backdrop:"pond-sunrise",time:"day",atmosphere:"petals",story:"山水像眼波眉峰一样清秀温柔，正送完春天又送老朋友去江南，如果你在江南赶上了春天，一定要和春天一起快乐住下呀！",layers:[["art/play/boat.webp",56,59,27,"sail",5],["art/play/mountain.webp",26,51,29,"idle",1],[e("blossom"),74,41,20,"glow",6]]},"p2b-j03":{group:"小船和朋友",backdrop:"snow-river",time:"mist",atmosphere:"wind",shortHint:"江上渔者",story:"江边往来的人只顾着称赞鲈鱼鲜美可口，可你们看一看呀，那小小的一叶扁舟正顶着风浪在江心里摇摇晃晃呢！",layers:[["art/play/boat.webp",52,57,29,"sail",2,6,0],["art/fish.webp",30,68,19,"swim",1,8,0],[e("wave"),69,69,20,"swim",3]]},"p6b-s05":{group:"小船和朋友",backdrop:"pond-sunrise",time:"mist",atmosphere:"wind",shortHint:"风波扁舟",story:"一叶小渔船在翻涌的江波里起伏打鱼，让人记住餐桌上每一道美食背后的辛劳。",layers:[["art/play/boat.webp",49,58,28,"sail",2],["art/fish.webp",72,67,19,"swim",1]]},"p6a-k05":{group:"小船和朋友",backdrop:"autumn-river",time:"dawn",atmosphere:"stars",story:"九曲黄河卷着万里黄沙滚滚扑来，诗人豪迈地幻想顺着大浪一直飞上天上银河，去做牛郎织女家的客人！",layers:[[e("wave"),46,61,26,"swim",0,12,0],[e("star"),69,24,21,"pulse",2],["art/play/boat.webp",30,56,22,"sail",2]]},"p6a-j02":{group:"小船和朋友",backdrop:"pond-sunrise",time:"day",atmosphere:"ripples",story:"昨夜春江水涨高啦，平日推都推不动的巨大战船突然变得像一片羽毛那样轻，在水中央自由自在地飞驰前进！",layers:[["art/play/boat.webp",52,56,33,"sail",3,14,0],[e("feather"),27,42,20,"float",1],[e("wave"),67,67,19,"swim",0]]},"p1b-j02":{group:"小船和朋友",backdrop:"lushan-waterfall",time:"mist",atmosphere:"mist",story:"在大松树下遇到小徒弟，小徒弟指指大山深处说：师父出门采药去啦，山里云雾这么浓，连我也不知道他在哪座山峰呢！",layers:[["art/wordbook/child.webp",36,62,31,"idle",0],["art/play/tree.webp",25,49,37,"idle",0],[e("cloud"),65,34,23,"drift",3,8,0]]},"p3b-k05":{group:"小船和朋友",backdrop:"spring-garden",time:"dawn",atmosphere:"sparks",story:"噼里啪啦的鞭炮声送走旧年迎来新年！太阳暖融融地照着千家万户，大家都喜气洋洋贴上崭新漂亮的春联桃符！",layers:[[e("house"),50,56,36,"idle",2],["art/play/sun.webp",78,22,22,"rise",2],[e("gift"),26,63,21,"hop",0]]},"p3b-k06":{group:"小船和朋友",backdrop:"spring-garden",time:"mist",atmosphere:"rain",story:"清明时节淅淅沥沥飘着春雨，赶路人正愁到哪休息，一个小牧童微笑着远远指向山谷里开满杏花的小村庄！",layers:[[e("rain-cloud"),40,23,22,"drift",0],["art/wordbook/child.webp",34,62,31,"idle",3],[e("blossom"),72,46,22,"glow",3],[e("house"),73,59,25,"idle",3]]},"p3b-k07":{group:"小船和朋友",backdrop:"autumn-river",time:"dusk",atmosphere:"leaves",story:"一个人出门在外过节时格外想家，远远想着故乡的哥哥弟弟一起登高戴着茱萸，就少了我一个人呀！",layers:[["art/play/mountain.webp",64,52,33,"idle",2],[e("maple-leaf"),29,44,20,"fall",0],[e("green-leaf"),66,38,17,"glow",3]]},"p6b-k01":{group:"小船和朋友",backdrop:"spring-garden",time:"dusk",atmosphere:"petals",story:"春天长安城到处飘飞着花瓣，柳枝斜斜轻拂春风，傍晚一盏盏温暖的蜡烛送往千家万户。",layers:[[e("blossom"),34,41,22,"fall",0,8,10],[e("lamp"),66,56,24,"glow",2],[e("steam"),66,39,17,"rise",3]]},"p5a-j02":{group:"小船和朋友",backdrop:"clearing-lake",time:"dawn",atmosphere:"petals",shortHint:"游子吟",story:"慈爱的妈妈在灯下一针一线把孩子出门穿的衣服缝得密密实实，母爱就像春天里最暖和的阳光，照进孩子心窝里。",layers:[[e("mother"),36,57,33,"idle",0],[e("yarn"),54,63,20,"pulse",2],["art/play/sun.webp",76,22,23,"glow",5],[e("grass"),72,68,20,"grow",4]]},"p5b-j01":{group:"小船和朋友",backdrop:"clearing-lake",time:"dawn",atmosphere:"clouds",shortHint:"谁言寸草心",story:"妈妈一针一线缝着游子的衣裳，温暖的三春阳光守护着小小的青草。",layers:[[e("mother"),37,56,33,"idle",0],["art/play/sun.webp",75,24,22,"glow",5],[e("seedling"),69,64,22,"grow",4]]},"p4a-k06":{group:"大漠和英雄",backdrop:"frontier-dusk",time:"dusk",atmosphere:"wind",story:"边塞月光下亮晶晶的夜光杯盛满葡萄酒，马上就要听着琵琶豪爽出发啦！",layers:[[e("tea-cup"),50,61,24,"glow",0],[e("grapes"),30,56,22,"idle",0],[e("horse"),74,57,29,"hop",1]]},"p4a-k07":{group:"大漠和英雄",backdrop:"frontier-dusk",time:"night",atmosphere:"wind",story:"还是秦汉时期的明月照在古老的边塞关城上，守卫边疆的勇士日夜坚守，绝不让敌人跨过阴山一步！",layers:[["art/play/moon.webp",72,22,23,"glow",0],[e("horse"),39,59,32,"hop",3,10,0],["art/play/mountain.webp",71,53,28,"idle",3]]},"p4a-k08":{group:"大漠和英雄",backdrop:"storm-plain",time:"dusk",atmosphere:"sparks",story:"活着要做顶天立地的大英雄，即使遇上困难也要有骨气、有担当，绝不随波逐流。",layers:[["art/play/mountain.webp",50,53,35,"idle",0],[e("finish-flag"),66,36,26,"sway",0]]},"p4b-k05":{group:"大漠和英雄",backdrop:"snow-river",time:"night",atmosphere:"snow",story:"月黑风高的夜晚，骑兵冒着鹅毛大雪追击逃走的敌军，漫天雪花落满了英雄手中的长弓和刀鞘！",layers:[[e("horse"),48,59,34,"hop",2,12,0],[e("snowflake"),30,30,18,"fall",3],[e("snowflake"),72,34,18,"fall",3]]},"p5a-k01":{group:"大漠和英雄",backdrop:"frontier-dusk",time:"dusk",atmosphere:"clouds",story:"八十五岁老诗人陆游一辈子最盼望祖国南北团圆，写下诗句嘱咐孩子将来一定要把好消息告诉他。",layers:[[e("book"),48,60,26,"idle",0],[e("finish-flag"),67,46,28,"sway",2]]},"p5a-k02":{group:"大漠和英雄",backdrop:"autumn-river",time:"dusk",atmosphere:"mist",story:"山外重重青山、楼外重重高楼，诗人在热闹的西湖边提醒大家不要忘记收复失地、居安思危。",layers:[["art/play/mountain.webp",33,51,31,"idle",0],[e("house"),67,54,30,"idle",0]]},"p5a-k03":{group:"大漠和英雄",backdrop:"storm-plain",time:"dusk",atmosphere:"wind",story:"沉闷的旧日子需要风雷唤醒生机！诗人呼唤天空降下不拘一格的聪明本领人才，让大地充满活力！",layers:[["art/wordbook/thunder.webp",50,34,34,"pulse",0],[e("horse"),52,65,29,"hop",1,10,0]]},"p5b-k04":{group:"大漠和英雄",backdrop:"frontier-dusk",time:"snow",atmosphere:"wind",story:"青海长长的乌云笼罩着大雪山，守城将军遥望玉门关，就算金铠甲磨穿了，不胜利也决不回家！",layers:[["art/play/mountain.webp",34,51,32,"idle",0],[e("cloud"),48,23,21,"drift",0],[e("horse"),70,61,29,"hop",3]]},"p5b-k05":{group:"大漠和英雄",backdrop:"lushan-waterfall",time:"dawn",atmosphere:"clouds",story:"奔腾三万里的黄河向东流入大海，五千仞的高山高高顶向蓝天，古老土地等着春天再次归来。",layers:[["art/play/mountain.webp",58,49,36,"rise",1],[e("wave"),31,63,23,"swim",0,10,0]]},"p5b-k06":{group:"大漠和英雄",backdrop:"spring-garden",time:"day",atmosphere:"petals",story:"杜甫听见收复家乡的大好消息高兴得眼泪直掉，胡乱收拾起书本就要带着家人坐船穿峡谷欢天喜地回家乡啦！",layers:[[e("book"),31,60,23,"hop",3],["art/play/boat.webp",64,58,28,"sail",6,12,0],["art/play/sun.webp",50,22,21,"glow",4]]},"p5b-j03":{group:"大漠和英雄",backdrop:"frontier-dusk",time:"dusk",atmosphere:"wind",story:"远远看去黄河像一条飘带直挂在白云之间，孤单的小城依偎在万丈高山旁，连春风都难吹过遥远的玉门关。",layers:[["art/play/mountain.webp",64,51,34,"idle",1],[e("cloud"),36,25,22,"drift",0,10,0],[e("wave"),33,62,22,"swim",0]]},"p3a-k07":{group:"古代小故事",backdrop:"clearing-lake",time:"day",atmosphere:"none",story:"一群小朋友在院子里玩，一个孩子爬到大水缸上不小心掉进水里！别人都吓跑了，聪明的小司马光捡起大石头砸破水缸，救出了小伙伴！",layers:[["art/wordbook/child.webp",36,61,32,"hop",1],[e("stone"),44,53,15,"hop",1,10,5],[e("water-drop"),74,70,17,"fall",1,4,6]],verseNotes:["好多孩子在院子水缸旁玩捉迷藏，呀！一个小娃娃滑进大水缸里啦！","大家吓得跑去喊大人，小司马光冷静搬起石头砸破水缸，水全流出来，小伙伴得救啦！"]},"p6a-k09":{group:"古代小故事",backdrop:"pond-sunrise",time:"day",atmosphere:"ripples",story:"大家正发愁怎么称出巨型大象有多重，五六岁的曹冲想出妙招：把大象牵上大船在水面画条线，再用石头装船对齐水线就能称出来啦！",layers:[[e("elephant"),49,49,32,"idle",2],["art/play/boat.webp",50,66,30,"sail",2],[e("stone"),74,63,18,"hop",2]]},"p3b-k04":{group:"古代小故事",backdrop:"sunny-field",time:"day",atmosphere:"clouds",story:"一只糊涂小兔子撞死在田边的树桩上，种田人高兴坏了，干脆放下农具整天蹲在树桩边等下一只兔子撞上来——结果庄稼荒了，再也没等到兔子。",layers:[[e("rabbit"),34,62,26,"hop",2,16,0],[e("log"),63,62,25,"idle",1],[e("shovel"),26,67,21,"idle",3]]},"p4a-k04":{group:"古代小故事",backdrop:"pond-sunrise",time:"dusk",atmosphere:"wind",story:"炎帝的小女儿变成了一只叫作“精卫”的小鸟，天天从西山衔起小树枝和小石子，飞到大海上方丢进去，想要把大海填平！",layers:[["art/play/bird.webp",50,35,24,"fly",1,12,4],[e("stone"),52,51,14,"fall",1,0,18],[e("wave"),64,69,22,"swim",1]]},"p4a-k05":{group:"古代小故事",backdrop:"sunny-field",time:"day",atmosphere:"leaves",story:"七岁的王戎看见大路边的李子树果实累累却没人摘，立刻聪明地想到：路边大家天天路过都没摘，这李子一定是苦的！一尝果然是苦李！",layers:[["art/play/tree.webp",56,51,41,"idle",1],["art/wordbook/child.webp",29,63,30,"idle",1],[e("peach"),57,41,16,"pulse",2]]},"p4b-k07":{group:"古代小故事",backdrop:"starry-night",time:"night",atmosphere:"fireflies",story:"爱读书的车胤家里穷买不起灯油，夏夜他用白纱袋装起几十只发亮的萤火虫当成小台灯，一直苦读到天亮。",layers:[[e("lamp"),58,49,25,"glow",1],[e("book"),39,62,25,"glow",1]]},"p4b-k08":{group:"古代小故事",backdrop:"autumn-river",time:"day",atmosphere:"ripples",story:"小李白读书怕难想偷懒溜走，在溪边遇见一位白发老婆婆正认真在石头上磨粗粗的铁棒——“只要天天坚持磨，铁棒也能磨成绣花针！”",layers:[[e("grandmother"),36,59,32,"idle",2],[e("stone"),58,66,22,"idle",2],["art/wordbook/child.webp",73,62,29,"idle",4]]},"p5b-k07":{group:"古代小故事",backdrop:"clearing-lake",time:"day",atmosphere:"clouds",story:"楚国商人吹牛说自己的盾什么都刺不破，又吹牛说自己的矛什么都能刺穿；路人一问“拿你的矛刺你的盾会怎样？”他瞬间呆住答不上来啦！",layers:[[e("talk"),52,34,24,"pulse",2],[e("laughing-child"),32,62,30,"hop",3],[e("calm-child"),69,62,29,"idle",3]]},"p5b-k08":{group:"古代小故事",backdrop:"clearing-lake",time:"day",atmosphere:"none",story:"客人开玩笑指着杨梅说“这是你杨家的果子吧？”九岁的杨氏小朋友机灵一转，立刻微笑回答：“没听说孔雀是您孔先生家的鸟呀！”",layers:[["art/wordbook/child.webp",37,61,31,"idle",4],["art/berry.webp",56,59,19,"pulse",2],["art/play/bird.webp",74,42,21,"fly",4]]},"p6a-k08":{group:"古代小故事",backdrop:"autumn-river",time:"dawn",atmosphere:"clouds",shortHint:"两小儿辩日·列子",story:"两个小孩辩论太阳什么时候离人近：早上的太阳大如车盖可凉飕飕，中午的太阳小如盘子却热呼呼，连大学问家孔子也笑了答不上来！",layers:[["art/play/sun.webp",28,30,24,"rise",3],["art/play/sun.webp",72,20,17,"glow",4],["art/wordbook/child.webp",34,64,29,"hop",1],[e("laughing-child"),68,64,29,"hop",2]]},"p6b-k08":{group:"古代小故事",backdrop:"sunny-field",time:"day",atmosphere:"clouds",shortHint:"两小儿辩日·列御寇",story:"早晨凉快大太阳、中午热呼呼小太阳，两个小娃娃认真辩论着为什么，启发我们多多观察大自然！",layers:[["art/play/sun.webp",50,24,24,"glow",3],["art/wordbook/child.webp",34,63,29,"idle",1],[e("laughing-child"),66,63,29,"idle",2]]},"p6b-k07":{group:"古代小故事",backdrop:"clearing-lake",time:"day",atmosphere:"none",story:"下棋高手同时教两个学生：一个人专心致志听讲，另一个人老想着天上有大鸟飞过，做任何事专心才能学得棒！",layers:[[e("calm-child"),33,62,30,"idle",1],["art/play/bird.webp",72,28,21,"fly",2,10,-4],[e("book"),48,64,22,"idle",1]]},"p1b-k03":{group:"古代小故事",backdrop:"spring-garden",time:"day",atmosphere:"none",story:"《三字经》告诉小朋友：就像一块玉要细心雕琢才好看，小朋友从小专心学习，长大了才会明白许多好道理。",layers:[[e("school"),33,56,33,"idle",3],[e("book"),66,59,25,"pulse",3],[e("pencil"),73,45,19,"sway",6]]},"p5a-k08":{group:"古代小故事",backdrop:"clearing-lake",time:"day",atmosphere:"none",story:"古人分享读书的三大宝贝：知道就是知道、不知要虚心请问；读书时更要让心、眼睛和嘴巴一齐专注到书本里。",layers:[[e("book"),42,57,29,"pulse",5],[e("eyes"),66,40,17,"glow",5],[e("heart"),66,62,17,"pulse",7]]},"p5a-k04":{group:"古代小故事",backdrop:"autumn-river",time:"dawn",atmosphere:"clouds",story:"早晨红彤彤的大太阳升起来、潜龙跃起、雄鹰展翅——朝气蓬勃的小朋友正在一步步让未来变得光明又远大！",layers:[["art/play/sun.webp",50,28,28,"rise",7,0,-6],["art/play/bird.webp",73,30,21,"fly",11,10,-6],[e("finish-flag"),26,52,27,"sway",16]]}},s={"p1a-k01":"water-voyage","p2a-k04":"frontier-epic","p2b-k03":"spring-blossom","p3b-k01":"spring-blossom","p3b-k02":"water-voyage","p4b-j03":"spring-blossom","p5b-j02":"night-moon","p6b-k04":"frontier-epic","p3a-k05":"water-voyage","p3a-k01":"night-moon","p3a-k06":"water-voyage","p5a-k05":"night-moon","p6a-k07":"pastoral-child","p4a-j01":"mountain-mist","p4b-k01":"pastoral-child","p4b-j01":"winter-plum","p5a-j04":"water-voyage","p6b-s03":"night-moon","p6b-j01":"water-voyage","p5a-j03":"water-voyage","p6a-k02":"water-voyage","p3b-j02":"water-voyage","p2a-j02":"water-voyage","p3a-k04":"water-voyage","p4b-k02":"spring-blossom","p5b-k02":"winter-plum","p1b-j02":"mountain-mist","p4a-j03":"frontier-epic","p6a-j03":"spring-blossom","p6b-s02":"spring-blossom","p3b-k05":"pastoral-child","p3