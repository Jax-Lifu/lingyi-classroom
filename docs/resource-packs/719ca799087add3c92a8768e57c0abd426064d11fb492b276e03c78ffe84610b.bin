.poem-theater{display:grid;gap:14px}.poem-stage{position:relative;box-sizing:border-box;width:100%;aspect-ratio:16 / 9;border-radius:22px;border:2px solid #4d6445;box-shadow:0 6px 20px -10px #22362961;overflow:hidden;isolation:isolate;container-type:inline-size;content-visibility:auto;contain-intrinsic-size:auto 540px;background:#dce6d2;cursor:pointer}.poem-stage-3d{position:absolute;inset:0;display:block;width:100%;height:100%;z-index:1;pointer-events:none}.poem-2d-fallback{position:absolute;inset:0;z-index:0}.poem-stage.with-gl3d .poem-2d-fallback{visibility:hidden;pointer-events:none}.poem-stage-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-3;transition:transform .9s cubic-bezier(.22,1,.36,1),filter .8s ease;-webkit-user-select:none;user-select:none;pointer-events:none}.poem-stage.line-focus-1 .poem-stage-bg{transform:scale(1.025) translate3d(-.6%,0,0)}.poem-stage.line-focus-2 .poem-stage-bg{transform:scale(1.04) translate3d(.6%,-.4%,0)}.poem-stage.line-focus-3 .poem-stage-bg{transform:scale(1.055) translate3d(0,-.8%,0)}.poem-stage-lighting{position:absolute;inset:0;z-index:-2;pointer-events:none;transition:background .7s ease}.poem-stage.time-dawn .poem-stage-lighting{background:linear-gradient(180deg,rgba(255,224,166,.22) 0%,transparent 58%)}.poem-stage.time-dusk .poem-stage-lighting{background:linear-gradient(180deg,#eb945642,#482e3424)}.poem-stage.time-night .poem-stage-lighting{background:linear-gradient(180deg,#101c3842,#101a301f)}.poem-stage.time-mist .poem-stage-lighting{background:linear-gradient(180deg,#eef4ee47,#d2e0d629)}.poem-stage.time-snow .poem-stage-lighting{background:linear-gradient(180deg,#e2eef842,#d6e4f02e)}.poem-seal{position:absolute;top:3.4%;left:2.6%;z-index:6;pointer-events:none;display:grid;justify-items:center;gap:2px;padding:7px 13px;border-radius:12px;background:#fff8e0eb;border:1.5px solid #bfa675;box-shadow:0 3px 10px -4px #2a311c59;color:#2c4635}.poem-seal small{font-size:clamp(11px,1.3vw,13px);color:#54664a;line-height:1.2}.poem-seal strong{font:750 clamp(16px,2vw,24px) / 1.2 "Songti SC","STSong",serif;letter-spacing:.04em}.poem-stage-hud{position:absolute;top:3.4%;right:2.6%;z-index:6;display:flex;align-items:center;gap:8px}.poem-verse-meter{padding:6px 12px;border-radius:99px;background:#fff9e8eb;border:1px solid rgba(164,152,118,.55);color:#344d3c;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;pointer-events:none}.poem-theater .poem-motion-btn{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;border:1.5px solid rgba(255,248,224,.72);background:#223e2ee6;color:#fffcee;padding:0;box-shadow:0 3px 10px -3px #12221873}.poem-theater .poem-motion-btn:hover{background:#234632}.poem-motion-btn .child-icon{width:20px;height:20px}.poem-stage-caption{position:absolute;left:50%;bottom:3.6%;transform:translate(-50%);z-index:6;max-width:min(88%,560px);padding:7px 18px;border-radius:99px;background:#1a2e23d1;border:1px solid rgba(255,244,210,.34);color:#fffcf0;font:650 clamp(15px,2vw,22px) / 1.35 "Kaiti SC","STKaiti","Songti SC",serif;text-align:center;letter-spacing:.04em;pointer-events:none;box-shadow:0 4px 14px -4px #0e1a1280}.poem-stage-caption .caption-hint{font-family:Yuanti SC,PingFang SC,system-ui,sans-serif;font-size:clamp(13px,1.55vw,17px);color:#f6e6b8}.poem-storyboard,.poem-drama{position:absolute;inset:0;cursor:pointer}.sb-slot{position:absolute;width:auto;transform:translate3d(calc(-50% + var(--sb-dx, 0px)),calc(-50% + var(--sb-dy, 0px)),0);transition:transform .85s cubic-bezier(.22,1,.36,1),opacity .6s ease,filter .6s ease;pointer-events:none}.sb-slot.is-upcoming{opacity:.45;transform:translate3d(-50%,-50%,0) scale(.9)}.sb-slot.is-active-beat{z-index:3;filter:drop-shadow(0 6px 14px rgba(255,243,189,.65))}.sb-art{display:block;height:100%;width:auto;max-width:none;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(30,40,22,.25))}.sb-slot.is-active-beat .sb-art{transform:scale(1.06);transition:transform .5s ease}.drama-art{display:block;width:100%;height:100%;object-fit:contain;-webkit-user-select:none;user-select:none;pointer-events:none;filter:drop-shadow(0 4px 7px rgba(26,38,22,.26))}.ink-figure{display:block;width:100%;height:100%;overflow:visible;filter:drop-shadow(0 3px 5px rgba(18,30,22,.28))}.y-water-shimmer{position:absolute;left:38%;top:66%;width:36%;height:12%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(255,252,232,.55) 0%,rgba(210,245,222,.22) 55%,transparent 75%);opacity:.45;transition:opacity .6s ease,transform .7s ease;pointer-events:none}.drama-yong-e.at-line-2 .y-water-shimmer{opacity:.92;transform:scale(1.12)}.y-lotus{position:absolute;left:81%;top:67%;height:18%;aspect-ratio:1.5;transform:translate(-50%,-50%);pointer-events:none}.y-poet-child{position:absolute;left:17%;top:61%;height:35%;aspect-ratio:.86;transform:translate(-50%,-50%);transition:transform .6s cubic-bezier(.22,1,.36,1);pointer-events:none}.drama-yong-e.at-line-0 .y-poet-child{transform:translate(-50%,-50%) rotate(4deg) scale(1.03)}.drama-yong-e.at-line-3 .y-poet-child{transform:translate(-50%,-53%) rotate(-3deg) scale(1.05)}.y-goose-rig{position:absolute;left:55%;top:56%;height:43%;aspect-ratio:1.15;transform:translate(-50%,-50%);transition:transform .8s cubic-bezier(.22,1,.36,1);pointer-events:none}.drama-yong-e.at-line-0 .y-goose-rig{transform:translate(-50%,-50%)}.drama-yong-e.at-line-1 .y-goose-rig{transform:translate(-50%,-52%)}.drama-yong-e.at-line-2 .y-goose-rig{transform:translate(-58%,-48%)}.drama-yong-e.at-line-3 .y-goose-rig{transform:translate(-41%,-46%) scale(1.06)}.y-goose-body{position:relative;width:100%;height:100%;transform-origin:48% 66%;transition:transform .65s cubic-bezier(.22,1,.36,1)}.drama-yong-e.at-line-1 .y-goose-body{transform:rotate(-16deg) translateY(-4%) scale(1.06)}.drama-yong-e.at-line-2 .y-goose-body{transform:rotate(2deg)}.drama-yong-e.at-line-3 .y-goose-body{transform:rotate(5deg)}.y-pond-ripples{position:absol