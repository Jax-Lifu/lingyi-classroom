.play-ground{padding-block:clamp(13px,2.4vw,28px) 30px}.play-heading,.adventure-title,.sound-toggle,.story-dialogue,.voice-disc,.prize,.parent-topics,.restart-round{display:flex;align-items:center}.play-heading{justify-content:space-between}.play-heading{margin-bottom:14px}.adventure-title{gap:12px}.adventure-title h1{font-size:clamp(29px,3.5vw,46px);font-weight:850;line-height:1.12;letter-spacing:.045em}.subject-ribbon{font-size:14px;font-weight:750;color:#476244;background:#e1e9ce;padding:6px 12px;border-radius:7px;transform:rotate(-4deg)}.sound-toggle,.restart-round{justify-content:center;gap:5px;border:1.5px solid #c5cdb8;background:#f3f5e7;color:#3f6244;border-radius:99px;min-height:45px;padding:7px 13px;font-size:14px!important}.play-book{border:2px solid #54694b;border-radius:24px;box-shadow:0 5px #d6d7bd;background:var(--stage-sheet, #fffcee);overflow:hidden}.world-stage{position:relative;width:100%;height:clamp(340px,38vw,477px);isolation:isolate;overflow:hidden;container-type:inline-size;background:#aacb99}.world-land{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 59%;z-index:-2;opacity:0;transition:opacity .5s ease}.world-land.current{opacity:1}.world-token,.stage-chapter,.basket-meter,.snapshot-caption{position:absolute;z-index:3;pointer-events:none}.world-token{top:7%;left:3.1%;width:clamp(69px,9vw,108px);min-height:80px;display:grid;place-content:center;justify-items:center;background:#fff5d5;color:#3d5136;border:1.5px solid #bda473;box-shadow:1px 4px #493c2030;border-radius:5px 8px 7px 5px;transform:rotate(-5deg);line-height:1.1;padding:9px 6px}.world-token:before{content:"";position:absolute;width:40%;height:12px;background:#a4b783d9;top:-5px;left:30%;transform:rotate(4deg);border-inline:2px dotted #e9edc8}.world-token small{font-size:clamp(11px,1.25vw,15px);line-height:1.2;max-width:100%;text-align:center}.world-token b{font:750 clamp(32px,4.2vw,58px)/1.22 "Kaiti SC","STKaiti",Georgia,serif}.world-token.long-to