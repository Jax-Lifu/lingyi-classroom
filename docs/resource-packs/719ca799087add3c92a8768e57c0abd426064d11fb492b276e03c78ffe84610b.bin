.scenic-theater{display:grid;gap:14px}.scenic-stage{position:relative;box-sizing:border-box;width:100%;aspect-ratio:16 / 9;border-radius:20px;border:2px solid #4d6445;box-shadow:0 6px 20px -10px #22362961;overflow:hidden;isolation:isolate;container-type:inline-size;content-visibility:auto;contain-intrinsic-size:auto 540px;background:#dce6d2;cursor:pointer}.pinyin-stage-3d,.english-stage-3d{position:absolute;inset:0;display:block;width:100%;height:100%;z-index:1;pointer-events:none}.scenic-2d-fallback{position:absolute;inset:0;z-index:0}.scenic-stage.with-gl3d .scenic-2d-fallback{visibility:hidden;pointer-events:none}.scenic-stage-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-3;-webkit-user-select:none;user-select:none;pointer-events:none}.scenic-stage-lighting{position:absolute;inset:0;z-index:-2;pointer-events:none}.scenic-stage.time-dawn .scenic-stage-lighting{background:linear-gradient(180deg,rgba(255,224,166,.22) 0%,transparent 58%)}.scenic-stage.time-dusk .scenic-stage-lighting{background:linear-gradient(180deg,#eb945642,#482e3424)}.scenic-stage.time-night .scenic-stage-lighting{background:linear-gradient(180deg,#101c3842,#101a301f)}.scenic-stage.time-mist .scenic-stage-lighting{background:linear-gradient(180deg,#eef4ee47,#d2e0d629)}.scenic-storyboard{position:absolute;inset:0;transition:opacity .35s ease;pointer-events:none}.scenic-storyboard[hidden]{display:none}.scenic-storyboard.is-soft{opacity:.48}.scenic-slot{position:absolute;width:auto;transform:translate3d(-50%,-50%,0);pointer-events:none}.scenic-art{display:block;height:100%;width:auto;max-width:none;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(30,40,22,.25))}.scenic-seal{position:absolute;top:3.4%;left:2.6%;z-index:6;pointer-events:none;display:grid;justify-items:center;gap:3px;padding:7px 14px;border-radius:12px;background:#fff8e0f0;border:1.5px solid #bfa675;box-shadow:0 3px 10px -4px #2a311c59;color:#2c4635}.scenic-seal small{font-size:clamp(11px,1.2vw,13px);color:#54664a;line-height:1.2}.scenic-seal strong{font-size:clamp(18px,2.2vw,26px);line-height:1.2;font-weight:800}.scenic-stage-hud{position:absolute;top:3.4%;right:2.6%;z-index:6;display:flex;align-items:center;gap:8px}.scenic-phase-pill{padding:6px 12px;border-radius:99px;background:#fff9e8f0;border:1px solid rgba(164,152,118,.55);color:#344d3c;font-size:13px;font-weight:700;pointer-events:none}.scenic-theater .scenic-motion-btn{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;border:1.5px solid rgba(255,248,224,.72);background:#223e2ee6;color:#fffcee;padding:0;box-shadow:0 3px 10px -3px #12221873}.scenic-theater .scenic-motion-btn:hover{background:#234632}.scenic-motion-btn .child-icon{width:20px;height:20px}.scenic-stage-caption{position:absolute;left:50%;bottom:3.6%;transform:translate(-50%);z-index:6;max-width:min(90%,600px);padding:7px 18px;border-radius:99px;background:#1a2e23d9;border:1px solid rgba(255,244,210,.34);color:#fffcf0;font-size:clamp(14px,1.75vw,19px);font-weight:700;line-height:1.38;text-align:center;pointer-events:none;box-shadow:0 4px 14px -4px #0e1a1280}.scenic-controls-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;border-radius:16px;background:var(--stage-panel, #f5f1e1);border:1px solid #d9d6be}.scenic-controls-bar button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:8px 14px;border-radius:99px;font-weight:700;transition:background-color .15s ease,border-color .15s ease,transform .14s ease}.scenic-controls-bar .child-icon{width:18px;height:18px}.scenic-primary-btn{background:#365e45;color:#fffef4!important;border:1.5px solid #2d503a;box-shadow:0 3px 10px -4px #223a2a73}.scenic-primary-btn:hover{background:#284b36}.scenic-primary-btn:disabled{opacity:.55}.scenic-mode-group{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.scenic-tool-btn{background:var(--stage-sheet, #fffdf5);color:#2f4b39;border:1px solid #c9c7ae}.scenic-tool-btn:hover{background:var(--stage-selected, #eaf1dd)}.scenic-tool-btn[aria-pressed=true]{background:var(--stage-selected, #dcead0);border-color:#5b7e54;color:#213e2c}.scenic-tool-btn.icon-only{width:44px;padding:0}.scenic-deck{border-radius:16px;border:1.5px solid #d9d6be;background:var(--stage-sheet, #fffdf4);padding:clamp(14px,2.2vw,22px);display:grid;gap:14px}.scenic-story-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:16px;background:var(--stage-panel, #f5f1e1);border:1px solid #d9d6be}.scenic-story-whisper{flex:1 1 280px;font-size:15px;line-height:1.55;color:#3d5241}.scenic-story-whisper strong{color:#2b4736}.scenic-finish-banner{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.scenic-finish-badge{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:99px;background:#e1eed3;color:#2c5239;font-size:14px;font-weight:700}.scenic-finish-badge .child-icon{width:16px;height:16px}.scenic-next-btn{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:8px 16px;border-radius:99px;background:#365e45;color:#fffef4!important;border:1.5px solid #2d503a;font-weight:750}.scenic-next-btn:hover{background:#284b36}.scenic-next-btn .child-icon{width:18px;height:18px}.scenic-replay-btn{display:inline-flex;align-items:center;gap:5px;min-height:44px;padding:8px 14px;border-radius:99px;background:var(--stage-sheet, #fffdf5);border:1px solid #c9c7ae;color:#2f4b39;font-weight:700}.scenic-replay-btn:hover{background:var(--stage-selected, #eaf1dd)}.scenic-replay-btn .child-icon{width:16px;height:16px}@media(prefers-reduced-motion:no-preference){.scenic-stage:not(.is-paused) .sb-motion-float{animation:sc-float 3.2s ease-in-out infinite}.scenic-stage:not(.is-paused) .sb-motion-swim{animation:sc-swim 3.6s ease-in-out infinite}.scenic-stage:not(.is-paused) .sb-motion-fly{animation:sc-fly 2.8s ease-in-out infinite}.scenic-