往右拨，看看火苗会往哪边偏。也可以换一丛竹子试试。",left:"风往左吹。换个方向，再看看。",right:"风往右吹。换个方向，再看看。",guess:"这次把风藏起来了。看火苗或竹梢，它往哪边偏？",retry:"再看看尖尖的那一头，它偏向哪一边？",guessed:"猜到了！你从它弯过去的方向找到了风。",bamboo:"同一阵风吹到竹梢。拨一拨，看它往哪边弯。",water:"水滴落下来，这簇火苗灭了。",earth:"泥土盖住了这簇火苗。点再试一次，还能换一种试。",elephant:"大象上船了。看看水面碰到船身哪里，给船画一道记号。",cargo:"现在用石头代替大象。试着让船上的记号碰到水面。",light:"船浮得还高，记号在水面上方。试试再放一块石头。",heavy:"船沉得有点深。点一下船上的石头，就能把它搬下来。",level:"船上的记号和水面对齐了！留下这个装法，再试另一种。",another:"刚才的装法收好了。这次换些不一样的石头吧。",same:"这个装法已经有了。试试用几块小石头换掉一块大的。",two:"找到了两种不同的装法，它们让船停在同一条水线上。",bear:"小熊说，你把笔给我。谁是现在的我？点一点，把笔递给它。",rabbit:"小兔说，你把笔给我。谁是现在的我？点一点，把笔递给它。",held:"笔已经在说话人手里了。换个人说，再听听。",other:"听，是谁在说我？把笔递给说话的那个朋友。",received:"收到了！把话筒换给另一个朋友，再听同一句话。",both:"两位朋友都接到了笔。换一个人开口，我指的人也换了。"},W=r=>"media/explorations/"+r+".mp3";function I({label:r,picture:t,onClick:s,disabled:a}){return e.jsxs("button",{type:"button",className:"lab-tool",disabled:a,onClick:s,children:[t&&e.jsx("img",{src:"./"+t,alt:""}),e.jsx("span",{children:r})]})}function We(r){const[t,s]=l.useState("flame"),[a,n]=l.useState(0),[u,b]=l.useState(null),x=l.useRef(new Set),[f,o]=l.useState(!1),[j,h]=l.useState(null);function i(){b(null),n(Math.random()<.5?-2:2),h("guess"),r.runtime.speak(W("guess"))}function m(N){const z=N===Math.sign(a)?"guessed":"retry";h(z),r.runtime.speak(W(z))}function g(N){const z=x.current;z.add(N),!f&&z.has("flame-wind")&&(z.has("bamboo-wind")||z.has("water")||z.has("earth"))&&(o(!0),r.onWin())}function k(N){n(N),N&&(t==="bamboo"||!u)&&g(t+"-wind")}function v(N){s(N),a&&(N==="bamboo"||!u)&&g(N+"-wind"),r.runtime.speak(W(N==="bamboo"?"bamboo":u??"wind"))}function c(N){b(N),g(N),r.runtime.sound(N==="water"?"splash":"touch"),r.runtime.speak(W(N))}const p=t==="bamboo",w=!p&&u,X=j||w||(a<0?"left":a>0?"right":p?"bamboo":"wind"),F=p?[S("bamboo","photo",53,58,51,{picture:_+"bamboo.webp",wind:a/2})]:[S("log","photo",52,74,19,{picture:_+"log.webp"}),w?S("trace","photo",52,65,22,{picture:w==="water"?_+"water-drop.webp":_+"shovel.webp"}):S("flame","flame",52,56,49,{wind:a/2})],V=a===0?"