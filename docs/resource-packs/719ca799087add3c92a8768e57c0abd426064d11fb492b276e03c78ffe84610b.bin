ass.webp",32,72,22],["art/wordbook/painted/cow.webp",50,54,46,"bow"]]},羊:{sentence:"小羊跳过一块石头。",setting:"meadow",layers:[["art/wordbook/painted/stone.webp",51,73,20],["art/wordbook/painted/sheep.webp",28,58,37,"leap",41,0]]},鸡:{sentence:"小鸡低头，啄一粒谷子。",setting:"clearing",layers:[["art/wordbook/painted/rice-stalks.webp",43,72,18],["art/wordbook/painted/chick.webp",51,55,42,"peck"]]},鸭:{sentence:"小鸭划着水，游向岸边。",setting:"pond",layers:[["art/wordbook/painted/duck.webp",33,56,40,"swim",28,8]]},米:{sentence:"一粒粒大米，来自沉甸甸的稻穗。",setting:"paper",layers:[["art/wordbook/painted/rice-stalks.webp",34,47,42,"bow"],["art/wordbook/painted/rice-bowl.webp",63,62,37,"reveal"]]},饭:{sentence:"饭碗端上来，开饭啦。",setting:"warm",layers:[["art/wordbook/painted/rice-bowl.webp",31,63,46,"serve",19,-6]]},面:{sentence:"一碗面端上桌，筷子伸过来。",setting:"paper",layers:[["art/wordbook/painted/noodles.webp",50,65,52],["art/wordbook/painted/chopsticks.webp",65,27,33,"tilt",-9,14]]},蛋:{sentence:"蛋壳裂开，小鸡探头啦。",setting:"meadow",layers:[["art/play/egg.webp",50,57,42,"shake"],["art/wordbook/painted/hatching-chick.webp",50,57,48,"reveal"]]},肉:{sentence:"夹起一块肉，放到盘子上。",setting:"paper",layers:[["art/play/plate.webp",56,72,40],["art/wordbook/painted/meat.webp",37,42,31,"arc",18,18]]},菜:{sentence:"绿油油的青菜放进菜篮。",setting:"paper",layers:[["art/play/basket.webp",57,69,39],["art/wordbook/painted/greens.webp",29,36,32,"arc",26,22]]},果:{sentence:"树上的果子熟了，落下来。",setting:"meadow",layers:[["art/play/tree.webp",49,54,62],["art/wordbook/painted/apple.webp",57,39,20,"fall",0,35]]},瓜:{sentence:"一个西瓜切开，露出红瓤。",setting:"paper",layers:[["art/wordbook/painted/watermelon.webp",47,55,43,"tilt"],["art/wordbook/painted/watermelon.webp",48,54,36,"glide",19,5]]},豆:{sentence:"豆子落进碗里，一颗又一颗。",setting:"warm",layers:[["art/wordbook/painted/empty-bowl.webp",54,67,44],["art/wordbook/painted/beans.webp",40,31,20,"drop",12,26]]},饼:{sentence:"一块圆饼，从盘边滚到中间。",setting:"paper",layers:[["art/play/plate.webp",55,71,44],["art/wordbook/painted/biscuit.webp",27,56,33,"roll",25,2]]}