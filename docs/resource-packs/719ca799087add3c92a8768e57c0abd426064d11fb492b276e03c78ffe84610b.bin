e:"day",atmosphere:"none",rhyme:"播下种子 b b b",mouthTip:"双唇合拢再轻轻放开，送气很弱。",story:"小手把种子播进松软的泥土，旁边已经冒出两片嫩芽。",toneForms:["bō","bó","bǒ","bò"],exampleTone:1,blend:{initial:"b",final:"ō",syllable:"bō",word:"播"},layers:[[i("sow-seeds"),50,54,52,"idle"]]},"initial-p":{group:"声母",backdrop:"tone-hills",time:"day",atmosphere:"none",rhyme:"泼出水花 p p p",mouthTip:"双唇合拢后放开，手心能感觉到一股气。",story:"小朋友端起木盆向前一泼，水珠在空中散成一片。",toneForms:["pō","pó","pǒ","pò"],exampleTone:1,blend:{initial:"p",final:"ō",syllable:"pō",word:"泼"},layers:[[i("splash-water"),48,53,54,"idle"]]},"initial-m":{group:"声母",backdrop:"clearing",time:"dawn",atmosphere:"none",rhyme:"摸摸小猫 m m m",mouthTip:"轻轻合上双唇，让声音从鼻腔出来。",story:"小手顺着小猫的背轻轻摸，软软的毛贴着手心。",toneForms:["mō","mó","mǒ","mò"],exampleTone:1,blend:{initial:"m",final:"ō",syllable:"mō",word:"摸"},layers:[[i("pet-kitten"),50,55,50,"idle"]]},"initial-f":{group:"声母",backdrop:"meadow",time:"day",atmosphere:"none",rhyme:"石雕佛像 f f f",mouthTip:"上齿轻触下唇，让气流从窄缝里通过。",story:"一尊石雕佛像坐在莲花座上，双手安放在身前。",toneForms:["fō","fó","fǒ","fò"],exampleTone:2,blend:{initial:"f",final:"ó",syllable:"fó",word:"佛"},layers:[[i("buddha-statue"),50,53,52,"idle"]]},"initial-d":{group:"声母",backdrop:"clearing",time:"day",atmosphere:"none",rhyme:"得到星星 d d d",mouthTip:"舌尖抵住上齿龈，再轻轻放开。",story:"小朋友得到一颗奖励星，举起来给大家看。",toneForms:["dē","dé","dě","dè"],exampleTone:2,blend:{initial:"d",final:"é",syllable:"dé",word:"得"},layers:[[i("smiling-child"),40,56,43,"idle"],[i("star"),65,40,25,"glow"]]},"initial-t":{group:"声母",backdrop:"spring-garden",time:"day",atmosphere:"none",rhyme:"特别的叶子 t t t",mouthTip:"舌尖抵住上齿龈，放开时送出一股气。",story:"三片叶子排好队。两片是绿的，中间那片红得特别显眼。",toneForms:["tē","té","tě","tè"],exampleTone:4,blend:{initial:"t",final:"è",syllable:"tè",word:"特"},layers:[[i("green-leaf"),27,55,26,"sway"],[i("maple-leaf"),50,54,32,"idle"],[i("green-leaf"),74,55,26,"sway"]]},"initial-n":{group:"声母",backdrop:"meadow",time:"day",atmosphere:"none",rhyme:"木讷少言 n n n",mouthTip:"舌尖抵住上齿龈，让声音从鼻腔出来。",story:"小朋友有些木讷，想了一会儿，才慢慢把心里的话说出来。",toneForms:["nē","né","ně","nè"],exampleTone:4,blend:{initial:"n",final:"è",syllable:"nè",word:"讷"},layers:[[i("quiet-speaker"),50,55,48,"idle"]]},"initial-l":{group:"声母",backdrop:"phonics-grove",time:"day",atmosphere:"none",rhyme:"收缰勒马 l l l",mouthTip:"舌尖轻抵上齿龈，让气流从舌头两边通过。",story:"骑手在桥前收住缰绳，勒马停步。",toneForms:["lē","lé","lě","lè"],exampleTone:4,blend:{initial:"l",final:"è",syllable:"lè",word:"勒"},layers:[[i("rein-horse"),47,57,50,"idle"]]},"initial-g":{group:"声母",backdrop:"spring-garden",time:"day",atmosphere:"none",rhyme:"哥哥传球 g g g",mouthTip:"舌根抵住软腭，再轻轻放开。",story:"哥哥弯下腰，把球递给比他矮一头的弟弟。",toneForms:["gē","gé","gě","gè"],exampleTone:1,blend:{initial:"g",final:"ē",syllable:"gē",word:"哥"},layers:[[i("big-brother"),50,55,51,"idle"]]},"initial-k":{group:"声母",backdrop:"clearing",time:"day",atmosphere:"none",rhyme:"科学观察 k k k",mouthTip:"舌根抵住软腭，放开时送气。",story:"科学课上，用显微镜仔细看看小小的叶片。",toneForms:["kē","ké","kě","kè"],exampleTone:1,blend:{initial:"k",final:"ē",syllable:"kē",word:"科"},layers:[[i("microscope"),50,56,50,"idle"]]},"initial-h":{group:"声母",backdrop:"meadow",time:"day",atmosphere:"none",rhyme:"喝口清水 h h h",mouthTip:"舌根靠近软腭，让气流轻轻擦过。",story:"走累了，端起杯子喝一口水。",toneForms:["hē","hé","hě","hè"],exampleTone:1,blend:{initial:"h",final:"ē",syllable:"hē",word:"喝"},layers:[[i("drink-water"),50,55,49,"idle"]]},"initial-j":{group:"声母",backdrop:"tone-hills",time:"dawn",atmosphere:"none",rhyme:"小鸡啄米 j j j",mouthTip:"舌面前部贴近硬腭再放开，轻短地读。",story:"小鸡迈着两条细腿，在草地上找食吃。",toneForms:["jī","jí","jǐ","jì"],exampleTone:1,blend:{initial:"j",final:"ī",syllable:"jī",word:"鸡"},layers:[[i("chick"),49,57,41,"hop"],[i("grass"),73,66,20,"sway"]]},"initial-q":{group:"声母",backdrop:"phonics-grove",time:"day",atmosphere:"none",rhyme:"数到七 q q q",mouthTip:"舌面前部贴近硬腭，放开时送气。",story:"上面四颗，下面三颗，一共七颗金星。",toneForms:["qī","qí","qǐ","qì"],exampleTone:1,blend:{initial:"q",final:"ī",syllable:"qī",word:"七"},layers:[[i("star"),23,27,17,"idle"],[i("star"),41,27,17,"idle"],[i("star"),59,27,17,"idle"],[i("star"),77,27,17,"idle"],[i("star"),32,59,17,"idle"],