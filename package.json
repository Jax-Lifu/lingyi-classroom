{
  "name": "lingyi-classroom",
  "version": "0.1.3",
  "description": "面向儿童的汉字、数学、拼音、古诗和英语启蒙",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @lingyi-classroom/web dev",
    "dev:desktop": "pnpm --filter @lingyi-classroom/desktop tauri dev",
    "ui:add": "shadcn add --cwd apps/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lingyi-classroom/web",
    "build:desktop": "pnpm --filter @lingyi-classroom/desktop tauri build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:rust": "cargo test --workspace --locked",
    "check": "pnpm typecheck && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "dev:web:home": "pnpm --filter @lingyi-classroom/web dev --mode household",
    "build:web:home": "pnpm --filter @lingyi-classroom/web build --mode household --outDir dist-household"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "shadcn": "4.22.1",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "private": true
}
